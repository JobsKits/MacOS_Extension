  local jobs_prompt_color=0
  if [ -t 0 ] && [ -t 2 ] && jobs_prompt_color_ready; then jobs_prompt_color=1; fi
  printf "%s" "$1" | jobs_prompt_format "$jobs_prompt_color" 0 0 1
}
# 仅放在显示链末端；tee 在此函数之前接收纯文本，不把 ANSI 写入日志。
jobs_prompt_stream() {
  local jobs_prompt_color=0
  if [ -t 1 ] && jobs_prompt_color_ready; then jobs_prompt_color=1; fi
  jobs_prompt_format "$jobs_prompt_color" 1 1
}
# 显示管道保留原末尾换行；只删除本轮追加的最后一个结束标记。
jobs_prompt_filter() {
  local jobs_prompt_color=0
  if [ -t 1 ] && jobs_prompt_color_ready; then jobs_prompt_color=1; fi
  { /bin/cat; printf '\001'; } | jobs_prompt_format "$jobs_prompt_color" 2 1
}
# 仅包装原 printf/echo/print 展示，原参数、尾换行与显示命令退出码保持不变。
jobs_prompt_output() {
  local jobs_prompt_status=0 jobs_prompt_stderr=0 jobs_prompt_arg="" jobs_prompt_previous=""
  if [ "${1:-}" = print ]; then
    for jobs_prompt_arg in "$@"; do
      case "$jobs_prompt_arg" in -?*u2*|-u2) jobs_prompt_stderr=1 ;; esac
      if [ "$jobs_prompt_previous" = -u ] && [ "$jobs_prompt_arg" = 2 ]; then jobs_prompt_stderr=1; fi
      jobs_prompt_previous="$jobs_prompt_arg"
      [ "$jobs_prompt_arg" != -- ] || break
    done
  fi
  if [ -n "${ZSH_VERSION:-}" ]; then
    if [ "$jobs_prompt_stderr" = 1 ]; then
      "$@" 2>&1 | jobs_prompt_filter >&2
      jobs_prompt_status=$(( ${pipestatus[1]} != 0 ? ${pipestatus[1]} : ${pipestatus[2]} ))
    else
      "$@" | jobs_prompt_filter
      jobs_prompt_status=$(( ${pipestatus[1]} != 0 ? ${pipestatus[1]} : ${pipestatus[2]} ))
    fi
  elif [ -n "${BASH_VERSION:-}" ]; then
    "$@" | jobs_prompt_filter
    jobs_prompt_status=$(( ${PIPESTATUS[0]} != 0 ? ${PIPESTATUS[0]} : ${PIPESTATUS[1]} ))
  else
    "$@" | jobs_prompt_filter
    jobs_prompt_status=$?
  fi
  return "$jobs_prompt_status"
}
# 仅替换日志 primitive 的 tee：磁盘同步追加纯文，终端保留非选项原色。
jobs_prompt_tee() {
  local jobs_prompt_log="$1" jobs_prompt_line="" jobs_prompt_newline=0
  while :; do
    jobs_prompt_line=""
    if IFS= read -r jobs_prompt_line; then jobs_prompt_newline=1; else jobs_prompt_newline=0; [ -n "$jobs_prompt_line" ] || break; fi
    if [ "$jobs_prompt_newline" = 1 ]; then
      { printf '%s\n' "$jobs_prompt_line"; printf '\001'; } | jobs_prompt_format 0 2 >> "$jobs_prompt_log" || return $?
      printf '%s\n' "$jobs_prompt_line" | jobs_prompt_filter || return $?
    else
      { printf '%s' "$jobs_prompt_line"; printf '\001'; } | jobs_prompt_format 0 2 >> "$jobs_prompt_log" || return $?
      printf '%s' "$jobs_prompt_line" | jobs_prompt_filter || return $?
    fi
  done
}
# JOBS_INPUT_CHOICE_STYLE_END

jobs_intro_style() {
  local intro_color=0
  if [ -t 1 ] && [ -n "${TERM:-}" ] && [ "${TERM:-}" != dumb ] &&
     [ -z "${NO_COLOR+x}" ] && [ "${PLAIN_OUTPUT:-0}" != 1 ] &&
     [ "${IS_SOURCETREE_RUNTIME:-0}" != 1 ]; then
    intro_color=1
  fi
  /usr/bin/awk -v color="$intro_color" -v role="${1:-body}" '
    BEGIN { esc = sprintf("%c", 27) }
    {
      gsub(esc "\\[[0-9;]*m", "")
      gsub(/\\(033|e|x1[bB])\[[0-9;]*m/, "")
      if (!color || $0 ~ /^[[:space:]]*$/) { print; next }
      numbered = ($0 ~ /^[[:space:]➤ℹ🔹✔⚠]*([0-9]+[、.)）]|[0-9]+️⃣|[-•])/)
      heading = ($0 ~ /^[[:space:]]*#{1,6}[[:space:]]/ || $0 ~ /[：:][[:space:]]*$/ || $0 ~ /^[[:space:]]*[=━─-]{3}/)
      title = (!numbered && (role == "title" || heading))
      if (role == "auto" && !seen && !numbered) title = 1
      if ($0 !~ /^[[:space:]]*[=━─-]+[[:space:]]*$/) seen = 1
      printf "%s%s%s\n", esc (title ? "[1;31m" : "[0;34m"), $0, esc "[0m"
    }
  '
}
RAW_SCRIPT_PATH="$0"
SCRIPT_PATH=""
SCRIPT_BASENAME=""
LOG_FILE=""
LOG_READY=0
IS_SOURCETREE_RUNTIME=0
PLAIN_OUTPUT=0
REPO_ROOT=""
UPSTREAM_REF=""
RESET_TARGET=""
RESET_MODE=""
SELECTION=""
REPO_ARGUMENT=""
REQUESTED_UPSTREAM_REF=""
TERMINAL_SOFT=0
INITIAL_HEAD_REF=""
INITIAL_HEAD_COMMIT=""
REPOSITORY_GIT_DIR=""
typeset -a UPSTREAM_CHOICES=()

# 仅以 Sourcetree 环境标记或父进程确认入口，不把命令行参数当作身份。
is_sourcetree_runtime() {
  /usr/bin/env | /usr/bin/grep -Ei '^SOURCETREE|^SOURCE_TREE' >/dev/null && return 0
  local process_id="$PPID" process_name="" guard=0
  while [[ -n "$process_id" && "$process_id" != 0 && "$guard" -lt 8 ]]; do
    process_name="$(/bin/ps -o comm= -p "$process_id" 2>/dev/null || true)"
    [[ "$process_name" == *SourceTree* || "$process_name" == *Sourcetree* ]] && return 0
    process_id="$(/bin/ps -o ppid= -p "$process_id" 2>/dev/null | /usr/bin/tr -d ' ' || true)"
    guard=$((guard + 1))
  done
  return 1
}
# 准备路径与纯文本输出，首屏不创建日志或改动 Git。
prepare_intro_context() {
  local filename="${RAW_SCRIPT_PATH:t}" candidate="${RAW_SCRIPT_PATH:A}"
  local fallback=""
  for fallback in "${HOME}/SourceTree.command/MacOS/${filename}/${filename}" "${HOME}/Documents/Github/JobsGenesis/SourceTree.command/MacOS/${filename}/${filename}"; do
    [[ -f "$candidate" ]] && break
    [[ -f "$fallback" ]] && candidate="$fallback"
  done
  SCRIPT_PATH="$candidate"
  SCRIPT_BASENAME="${filename:r}"
  LOG_FILE="${${TMPDIR:-/tmp}:A}/${SCRIPT_BASENAME}.$(/bin/date '+%Y%m%d-%H%M%S').$$.log"
  is_sourcetree_runtime && IS_SOURCETREE_RUNTIME=1
  if [[ "${1:-}" == --terminal-soft ]]; then
    TERMINAL_SOFT=1
    IS_SOURCETREE_RUNTIME=0
  fi
  configure_output_mode
}
# 确认前后均配置外部命令的纯文本环境。
configure_output_mode() {
  if [[ "$IS_SOURCETREE_RUNTIME" == 1 || ! -t 1 || -z "${TERM:-}" || "${TERM:-}" == dumb || -n "${NO_COLOR+x}" ]]; then
    PLAIN_OUTPUT=1
    export NO_COLOR=1 FORCE_COLOR=0 CLICOLOR=0 ANSI_COLORS_DISABLED=1 npm_config_color=false
  fi
  return 0
}
strip_ansi_stream() {
  /usr/bin/perl -pe 's/\e\[[0-9;]*[[:alpha:]]//g'
}
# 展示颜色与业务正文分开，路径中的反斜杠保持原值。
log() {
  local level="$1" message="$2" rendered="$2" color=""
  case "$level" in
    info) color=$'\033[1;34m' ;;
    success) color=$'\033[1;32m' ;;
    warn) color=$'\033[1;33m' ;;
    error) color=$'\033[1;31m' ;;
  esac
  [[ "$PLAIN_OUTPUT" == 1 ]] || rendered="${color}${message}"$'\033[0m'
  if [[ "$LOG_READY" == 1 ]]; then
    print -r -- "$rendered" | jobs_prompt_tee "$LOG_FILE"
  else
    print -r -- "$rendered"
  fi
}
info_echo() { log info "ℹ $1"; }
success_echo() { log success "✔ $1"; }
warn_echo() { log warn "⚠ $1"; }
error_echo() { log error "✖ $1"; }
# 自述失败必须终止，不能进入后面的重置逻辑。
show_script_intro_and_wait() {
  prepare_intro_context "$@"
  print -r -- "============================== Git 提交回退 ==============================" | jobs_intro_style title
  print -r -- "脚本名称：${SCRIPT_BASENAME}.command" | jobs_intro_style title
  print -r -- "1、soft 只移动当前分支，保留已有索引和工作区；是否有待提交内容以实际差异为准。" | jobs_intro_style body
  print -r -- "2、Sourcetree 多远端快照不同时转交 Terminal 明确选择；终端也支持选择历史提交 soft 回退。" | jobs_intro_style body
  print -r -- "3、默认采用 upstream；可用 --upstream refs/remotes/远端/分支明确指定，不自动 fetch。" | jobs_intro_style body
  print -r -- "4、soft 目标必须是 HEAD 祖先；选择期间分支或快照变化时停止，请重新核对。" | jobs_intro_style body
  print -r -- "5、所有 hard 模式会舍弃已跟踪的未提交内容，必须输入 YES；不递归重置子模块。" | jobs_intro_style body
  print -r -- "取消方式：Ctrl+C；日志位于 ${LOG_FILE}" | jobs_intro_style body
  if [[ "$IS_SOURCETREE_RUNTIME" == 1 ]]; then
    return 0
  fi
  if [[ ! -t 0 ]]; then
    print -u2 -r -- "当前不是 Sourcetree，且没有可交互输入；请在终端重新运行。"
    exit 1
  fi
  read -r "?$(jobs_prompt_render '已了解用途与影响，按回车继续；Ctrl+C 取消：')" _ || exit 1
}
initialize_script_runtime() {
  emulate -R zsh
  setopt NO_NOMATCH ERR_EXIT PIPE_FAIL
  export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"
  : > "$LOG_FILE"
  LOG_READY=1
  configure_output_mode
}
# 清理仅限本进程的 Git 定位变量，避免父仓环境覆盖明确传入的子仓路径。
isolate_git_context() {
  unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX GIT_NAMESPACE
}
check_environment() {
  command -v git >/dev/null && git --version >/dev/null || { error_echo "Git 不可用。"; return 1; }
}
# 解析仓库与显式远端引用；终端承接标志只能位于首参数。
parse_arguments() {
  [[ "${1:-}" != --terminal-soft ]] || shift
  while (( $# )); do
    case "$1" in
      --upstream)
        (( $# >= 2 )) && [[ -n "$2" ]] || { error_echo '--upstream 缺少完整远端跟踪引用。'; return 1; }
        REQUESTED_UPSTREAM_REF="$2"
        shift 2
        ;;
      --*) error_echo "未知参数：$1"; return 1 ;;
      *)
        [[ -z "$REPO_ARGUMENT" ]] || { error_echo '只能指定一个仓库目录。'; return 1; }
        REPO_ARGUMENT="$1"
        shift
        ;;
    esac
  done
}
# 拖入路径只做字符串解引用，不执行用户输入。
resolve_repository() {
  local candidate="${1:-${REPO:-}}" entered=""
  if [[ -z "$candidate" ]]; then
    if [[ "$IS_SOURCETREE_RUNTIME" == 1 ]]; then
      error_echo '未收到仓库路径；请在动作参数栏填写 $REPO。'
      return 1
    fi
    jobs_prompt_output info_echo "输入或拖入仓库路径；直接回车使用当前目录：${PWD}"
    read -r "entered?$(jobs_prompt_render '仓库路径：')" || return 1
    candidate="${entered:-$PWD}"
  fi
  candidate="${candidate%$'\r'}"
  [[ -e "$candidate" ]] || candidate="${(Q)candidate}"
  [[ -f "$candidate" ]] && candidate="${candidate:h}"
  [[ -d "$candidate" ]] || { error_echo "目标目录不存在：${candidate}"; return 1; }
  REPO_ROOT="$(git -C "$candidate" rev-parse --show-toplevel 2>/dev/null)" || { error_echo "目标不在 Git 工作树中：${candidate}"; return 1; }
  REPO_ROOT="${REPO_ROOT:A}"
  REPOSITORY_GIT_DIR="$(git -C "$REPO_ROOT" rev-parse --absolute-git-dir)" || return $?
  INITIAL_HEAD_REF="$(git -C "$REPO_ROOT" symbolic-ref --quiet HEAD 2>/dev/null || true)"
  INITIAL_HEAD_COMMIT="$(git -C "$REPO_ROOT" rev-parse --verify 'HEAD^{commit}' 2>/dev/null)" || { error_echo '当前仓库尚无有效 HEAD 提交，无法回退。'; return 1; }
  info_echo "当前 Git 仓库：${REPO_ROOT}"
  local parent="$(git -C "$REPO_ROOT" rev-parse --show-superproject-working-tree)"
  [[ -z "$parent" ]] || info_echo "直属父仓：${parent}；本次只回退当前子仓，父仓暂存区不变。"
  return 0
}
# 冲突、未完成操作或游离 HEAD 下不能把回退解释为未推送提交撤回。
check_repository_state() {
  local metadata="" unmerged="" marker=""
  metadata="$(git -C "$REPO_ROOT" rev-parse --absolute-git-dir)" || return $?
  unmerged="$(git -C "$REPO_ROOT" ls-files --unmerged)" || return $?
  if [[ -n "$unmerged" ]]; then
    error_echo "存在未解决冲突，请先处理。"
    return 1
  fi
  for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG rebase-merge rebase-apply sequencer index.lock; do
    [[ ! -e "${metadata}/${marker}" ]] || { error_echo "存在未完成操作或锁：${marker}"; return 1; }
  done
}
# 重新核对仓库、分支与起始提交，交互过程中切换或更新过就停止。
check_reset_context() {
  local metadata="" current_root="" current_ref="" current_commit=""
  metadata="$(git -C "$REPO_ROOT" rev-parse --absolute-git-dir)" || return $?
  current_root="$(git -C "$REPO_ROOT" rev-parse --show-toplevel)" || return $?
  current_ref="$(git -C "$REPO_ROOT" symbolic-ref --quiet HEAD 2>/dev/null || true)"
  current_commit="$(git -C "$REPO_ROOT" rev-parse --verify 'HEAD^{commit}' 2>/dev/null)" || return $?
  if [[ "$metadata" != "$REPOSITORY_GIT_DIR" || "${current_root:A}" != "$REPO_ROOT" || "$current_ref" != "$INITIAL_HEAD_REF" || "$current_commit" != "$INITIAL_HEAD_COMMIT" ]]; then
    error_echo '选择或确认期间仓库、分支或 HEAD 已变化；保持现状，请重新运行并核对。'
    return 1
  fi
  check_repository_state
}
# 参数必须是真实完整远端引用，不接受 ~1、^ 或 @{...} 等修订表达式。
verify_upstream_reference() {
  local ref="$1"
  [[ "$ref" == refs/remotes/* ]] && git -C "$REPO_ROOT" check-ref-format "$ref" &&
    git -C "$REPO_ROOT" show-ref --verify --quiet "$ref" || {
      error_echo "远端跟踪引用不存在或格式不完整：${ref}"
      return 1
    }
}
# 收集当前分支各线路已有快照及真实 upstream，不扫描或选择别的仓库。
collect_upstream_choices() {
  local branch="$(git -C "$REPO_ROOT" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  local remote="" ref="" configured=""
  UPSTREAM_CHOICES=()
  [[ -n "$branch" ]] || return 0
  configured="$(git -C "$REPO_ROOT" rev-parse --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
  if [[ "$configured" == refs/remotes/* ]] && git -C "$REPO_ROOT" rev-parse --verify "${configured}^{commit}" >/dev/null 2>&1; then
    UPSTREAM_CHOICES+=("$configured")
  fi
  for remote in "${(@f)$(git -C "$REPO_ROOT" remote)}"; do
    ref="refs/remotes/${remote}/${branch}"
    if git -C "$REPO_ROOT" rev-parse --verify "${ref}^{commit}" >/dev/null 2>&1; then
      UPSTREAM_CHOICES+=("$ref")
    fi
  done
  UPSTREAM_CHOICES=("${(@u)UPSTREAM_CHOICES}")
}
# 只读取本地跟踪快照；显式选择优先，不因某条线路拒收而自动改用另一条。
resolve_upstream_target() {
  local branch="$(git -C "$REPO_ROOT" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  local configured_remote="" ref="" commit=""
  local -a choices=()
  local -A snapshot_commits=()
  [[ -n "$branch" ]] || { error_echo "游离 HEAD 没有明确当前分支，不能回退到远端。"; return 1; }
  configured_remote="$(git -C "$REPO_ROOT" config --get "branch.${branch}.remote" || true)"
  UPSTREAM_REF="$REQUESTED_UPSTREAM_REF"
  if [[ -z "$UPSTREAM_REF" && "$IS_SOURCETREE_RUNTIME" != 1 ]]; then
    collect_upstream_choices
    if (( ${#UPSTREAM_CHOICES} > 1 )); then
      for ref in "${UPSTREAM_CHOICES[@]}"; do
        commit="$(git -C "$REPO_ROOT" rev-parse "$ref")"
        snapshot_commits[$ref]="$commit"
        choices+=("${ref} [${commit[1,12]}]")
      done
      choose_entry '选择本地远端快照（不联网）' 1 "${choices[@]}" || return $?
      [[ -n "$SELECTION" ]] || return 20
      UPSTREAM_REF="${SELECTION%% *}"
    fi
  fi
  [[ -n "$UPSTREAM_REF" ]] || UPSTREAM_REF="$(git -C "$REPO_ROOT" rev-parse --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
  if [[ -z "$UPSTREAM_REF" && -z "$configured_remote" ]]; then
    UPSTREAM_REF="refs/remotes/origin/${branch}"
  fi
  verify_upstream_reference "$UPSTREAM_REF" || return $?
  RESET_TARGET="$(git -C "$REPO_ROOT" rev-parse --verify "${UPSTREAM_REF}^{commit}" 2>/dev/null)" || { error_echo "远端跟踪引用不可用：${UPSTREAM_REF}"; return 1; }
  if [[ -n "${snapshot_commits[$UPSTREAM_REF]:-}" && "$RESET_TARGET" != "${snapshot_commits[$UPSTREAM_REF]}" ]]; then
    error_echo '远端跟踪快照在选择期间已变化；没有回退，请重新选择。'
    return 1
  fi
  info_echo "本地跟踪快照：${UPSTREAM_REF} [${RESET_TARGET}]"
}
# 远端 soft 的目标来自已验证的引用，索引和工作区保持原样。
reset_soft_to_remote() {
  resolve_upstream_target || return $?
  reset_soft_to_target "$UPSTREAM_REF"
}
# soft 仅回退到 HEAD 的祖先；提交数不等于净文件差异数。
reset_soft_to_target() {
  local description="$1"
  check_reset_context || return $?
  if ! git -C "$REPO_ROOT" merge-base --is-ancestor "$RESET_TARGET" "$INITIAL_HEAD_COMMIT"; then
    error_echo "目标不是 HEAD 的祖先：${description}；本地可能落后或分叉，请先检查历史。"
    return 1
  fi
  local ahead=""
  ahead="$(git -C "$REPO_ROOT" rev-list --count "${RESET_TARGET}..${INITIAL_HEAD_COMMIT}")" || return $?
  if [[ "$ahead" == 0 ]]; then
    info_echo "HEAD 已与所选目标一致：${description} [${RESET_TARGET}]；本次没有撤回提交。"
    info_echo '这只代表所选线路；其它远端可能尚未同步。撤回已同步提交可在终端选择“选择提交 soft 回退”。'
    report_staged_changes
    return $?
  fi
  info_echo "仅在本地撤回 ${ahead} 个提交到 ${description}，保留工作区及已有索引；其它远端可能已经包含这些提交。"
  check_reset_context || return $?
  run_git reset --soft "$RESET_TARGET" || return $?
  success_echo "已 soft 回退到 ${description} [${RESET_TARGET}]。"
  report_staged_changes
}
# 依据真实索引报告结果，空提交或净变化抵消时不虚报待提交文件。
report_staged_changes() {
  local diff_result=0 summary=""
  git -C "$REPO_ROOT" diff --cached --quiet --ignore-submodules=none || diff_result=$?
  case "$diff_result" in
    0) info_echo '暂存区相对当前 HEAD 没有文件差异；空提交或内容相互抵消时属于正常结果。' ;;
    1)
      summary="$(git -C "$REPO_ROOT" diff --cached --shortstat --ignore-submodules=none)" || return $?
      info_echo "待提交差异：${summary}；请在当前仓库的 Sourcetree 文件状态中核对。"
      ;;
    *) error_echo '无法读取暂存差异，请保留现场检查。'; return "$diff_result" ;;
  esac
}
# 保留外部 Git 的原始退出码，任何重置失败都不能打印成功。
run_git() {
  local -a result_codes=()
  if git -C "$REPO_ROOT" "$@" 2>&1 | strip_ansi_stream | tee -a "$LOG_FILE"; then
    return 0
  else
    result_codes=("${pipestatus[@]}")
  fi
  local result_code=0
  for result_code in "${result_codes[@]}"; do
    (( result_code == 0 )) || return "$result_code"
  done
  return 1
}
# 摘要仅用于 hard 确认期间的变化检测，不修改索引或写入对象库。
capture_hard_reset_state() {
  local index_file="" index_digest=missing worktree_digest="" status_digest=""
  index_file="$(git -C "$REPO_ROOT" rev-parse --path-format=absolute --git-path index)" || return $?
  if [[ -f "$index_file" ]]; then
    index_digest="$(/usr/bin/shasum -a 256 "$index_file")" || return $?
  fi
  worktree_digest="$(git --no-optional-locks -c diff.autoRefreshIndex=false -C "$REPO_ROOT" diff --no-ext-diff --no-textconv --binary --ignore-submodules=all | /usr/bin/shasum -a 256)" || return $?
  status_digest="$(git --no-optional-locks -C "$REPO_ROOT" status --porcelain=v1 -z --untracked-files=all --ignore-submodules=none | /usr/bin/shasum -a 256)" || return $?
  print -r -- "$index_digest" "$worktree_digest" "$status_digest"
}
# hard 以已解析的提交号固定目标，防止 tag 名歧义和确认后引用变化。
confirm_and_reset_hard() {
  local target="$1" description="$2" answer="" commit="" before_state="" current_state=""
  [[ "$IS_SOURCETREE_RUNTIME" != 1 && -t 0 ]] || { error_echo 'hard 回退只允许在独立交互终端确认。'; return 1; }
  check_reset_context || return $?
  commit="$(git -C "$REPO_ROOT" rev-parse --verify "${target}^{commit}" 2>/dev/null)" || { error_echo "所选目标不是有效提交：${description}"; return 1; }
  before_state="$(capture_hard_reset_state)" || return $?
  warn_echo "仓库：${REPO_ROOT}"
  warn_echo "hard 回退目标：${description} [${commit}]；已跟踪的未提交内容会被舍弃。"
  read -r "answer?$(jobs_prompt_render '输入 YES 执行；其它输入取消：')" || return 1
  if [[ "$answer" != YES ]]; then
    info_echo "已取消 hard 回退。"
    return 0
  fi
  check_reset_context || return $?
  current_state="$(capture_hard_reset_state)" || return $?
  [[ "$current_state" == "$before_state" ]] || { error_echo '确认期间索引或已跟踪改动发生变化；未执行 hard 回退，请重新核对。'; return 1; }
  check_reset_context || return $?
  run_git -c submodule.recurse=false reset --hard --no-recurse-submodules "$commit" || return $?
  success_echo "已 hard 回退到 ${commit}；子模块工作树保持原状。"
}
# fzf 区分返回、取消和失败；非根选择按左方向键返回模式层。
# JOBS_FZF_REQUIRED_BEGIN
# Homebrew 条件准备，来源为本轮现行 Jobs 自维护实现。
jobs_brew_note() {
  jobs_prompt_output print -u2 -r -- "ℹ $*"
  if [[ "${_JOBS_ENV_LOG_READY:-0}" == 1 && -n "${LOG_FILE:-}" ]]; then
    print -r -- "ℹ $*" >> "$LOG_FILE"
  fi
  return 0
}
# 验证候选能够执行；共享安装只读不代表未安装。
jobs_brew_candidate_ok() {
  local candidate="$1" prefix
  [[ -n "$candidate" && -x "$candidate" ]] || return 1
  HOMEBREW_NO_AUTO_UPDATE=1 "$candidate" --version >/dev/null 2>&1 || return 1
  prefix="$("$candidate" --prefix 2>/dev/null)" || return 1
  [[ "$prefix" == /* && -d "$prefix" ]]
}
# 发现既有健康安装，不以目录可写性决定是否重新安装。
jobs_brew_find() {
  local candidate
  local -a candidates
  candidates=("${JOBS_HOMEBREW_BIN:-}" "$(command -v brew 2>/dev/null)" /opt/homebrew/bin/brew /usr/local/bin/brew
    "${JOBS_HOMEBREW_INSTALL_PREFIX:-$HOME/.local/homebrew}/bin/brew" "$HOME/.homebrew/bin/brew")
  for candidate in "${candidates[@]}"; do
    if jobs_brew_candidate_ok "$candidate"; then
      print -r -- "$candidate"
      return 0
    fi
  done
  return 1
}
# 计算官方系统目录；实际支持范围和授权交由官方安装器处理。
jobs_brew_system_prefix() {
  case "$(/usr/bin/uname -m)" in
    arm64) print -r -- /opt/homebrew ;;
    *) print -r -- /usr/local ;;
  esac
}
# 缺失时强提示选择安装路径；YES 只表示选择系统目录，不验证密码或权限。
jobs_brew_choose_installation() {
  local answer="" system_prefix="$(jobs_brew_system_prefix)"
  if [[ ! -t 0 || ! -t 2 || "${IS_SOURCETREE_RUNTIME:-0}" == 1 ]]; then
    jobs_brew_note "缺少 Homebrew，需要人工选择安装路径；请在可交互终端重新运行，未执行安装。"
    return 1
  fi
  print -u2 -r -- "⚠ Homebrew 尚未就绪，必须先选择安装路径："
  print -u2 -r -- "1、输入精确大写 YES：选择系统标准目录 $system_prefix（Apple Silicon：/opt/homebrew；Intel：/usr/local）。"
  print -u2 -r -- "   这表示你准备向系统目录安装；官方安装器可能随后要求管理员密码，并自行验证权限。"
  jobs_prompt_output print -u2 -r -- "2、其它输入或直接回车：选择用户目录 ${JOBS_HOMEBREW_INSTALL_PREFIX:-$HOME/.local/homebrew}，不使用 sudo；有管理员权限也可选此路径。"
  print -u2 -r -- "本步骤只选择路径，不收集或验证密码；选定路径失败就停止，不自动切换。按 Ctrl+C 取消整个任务。"
  print -u2 -n -r -- "$(jobs_prompt_render "➤ 安装路径选择：")"
  if ! IFS= read -r answer; then
    jobs_brew_note "输入已取消或结束，停止安装。"
    return 1
  fi
  if [[ "$answer" == YES ]]; then
    typeset -g JOBS_HOMEBREW_INSTALL_MODE=system
  else
    typeset -g JOBS_HOMEBREW_INSTALL_MODE=user
  fi
}
# 持续获取临时网络失败；只尝试已声明官方地址，确定错误和取消立即停止。
jobs_brew_download_file() {
  local destination="$1" description="$2" download_url attempt download_result=1 http_code
  local retry_round=0 retry_delay=1 round_has_retryable=0
  local -a request_headers download_urls
  local -A blocked_urls
  shift 2
  download_urls=("$@")
  (( ${#download_urls} > 0 )) || { jobs_brew_note '没有已声明的官方获取地址。'; return 2; }
  while true; do
    (( retry_round += 1 ))
    round_has_retryable=0
    for download_url in "${download_urls[@]}"; do
      [[ -z "${blocked_urls[$download_url]:-}" ]] || continue
      request_headers=()
      if [[ "$download_url" == https://api.github.com/repos/Homebrew/install/contents/install.sh\?ref=HEAD ]]; then
        request_headers=(-H 'Accept: application/vnd.github.raw+json')
      fi
      for attempt in 1 2 3; do
        jobs_brew_note "下载${description}（第 $retry_round 轮，第 $attempt 次）：$download_url"
        download_result=0
        http_code="$(curl -q -fsSL --proto '=https' --proto-redir '=https' \
          --connect-timeout 10 --max-time 30 "${request_headers[@]}" \
          --write-out '%{http_code}' "$download_url" -o "$destination" \
          2> >(tee -a "${LOG_FILE:-/dev/null}" >&2))" || download_result=$?
        if (( download_result == 0 )); then
          return 0
        fi
        rm -f -- "$destination" || return 1
        jobs_brew_note "${description}下载失败：curl 退出码 $download_result，HTTP ${http_code:-未知}。"
        case "$download_result" in
          129|130|143) return "$download_result" ;;
          5|6|7|18|28|35|52|55|56) ;;
          22)
            if [[ "$http_code" != 408 && "$http_code" != 429 && "$http_code" != 5[0-9][0-9] ]]; then
              blocked_urls[$download_url]=1
              break
            fi
            ;;
          *) blocked_urls[$download_url]=1; break ;;
        esac
        if (( attempt < 3 )); then
          jobs_brew_note '临时连接失败，1 秒后重试同一官方地址；Ctrl+C 可取消。'
          sleep 1 || return $?
        fi
      done
      if [[ -z "${blocked_urls[$download_url]:-}" ]]; then
        round_has_retryable=1
      fi
      jobs_brew_note '当前地址尚未取得可用响应；如有下一已声明官方地址，将按原顺序尝试，安装目录不变。'
    done
    if (( round_has_retryable == 0 )); then
      jobs_brew_note "获取${description}遇到确定错误，停止；未执行安装。日志：${LOG_FILE:-终端输出}。"
      return "$download_result"
    fi
    jobs_brew_note "官方来源暂时不可用，${retry_delay} 秒后继续下一轮；不设总次数或总时长上限，按 Ctrl+C 取消。"
    sleep "$retry_delay" || return $?
    if (( retry_delay < 30 )); then
      retry_delay=$(( retry_delay * 2 ))
      (( retry_delay <= 30 )) || retry_delay=30
    fi
  done
}
# 校验官方安装脚本后仅执行一次，下载失败与安装失败分别报告。
jobs_brew_install_system() {
  local installer system_prefix="$(jobs_brew_system_prefix)" installer_result=0
  command -v curl >/dev/null 2>&1 || { jobs_brew_note "缺少 curl，无法获取官方安装器。"; return 1; }
  installer="$(mktemp "${TMPDIR:-/tmp}/jobs-homebrew-install.XXXXXX")" || return 1
  if jobs_brew_download_file "$installer" 'Homebrew 官方安装器' \
      https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh \
      'https://api.github.com/repos/Homebrew/install/contents/install.sh?ref=HEAD'; then
    if [[ ! -s "$installer" || "$(head -n 1 "$installer")" != '#!/bin/bash' ]] || ! /bin/bash -n "$installer"; then
      rm -f -- "$installer"
      jobs_brew_note '官方安装器响应为空或内容校验失败（可能是 HTML / JSON 错误页）；未执行安装。'
      return 1
    fi
  else
    installer_result=$?
    rm -f -- "$installer"
    jobs_brew_note "系统目录安装器下载失败（curl 退出码 $installer_result）；尚未执行安装，不自动切换安装路径。"
    return "$installer_result"
  fi
  /bin/bash "$installer" || installer_result=$?
  rm -- "$installer"
  if (( installer_result != 0 )); then
    jobs_brew_note "系统目录安装失败（退出码 $installer_result）；停止，不自动切换安装路径。"
    return "$installer_result"
  fi
  typeset -g JOBS_HOMEBREW_BIN="$system_prefix/bin/brew"
  jobs_brew_candidate_ok "$JOBS_HOMEBREW_BIN" || { jobs_brew_note "官方安装器结束后未找到健康 Homebrew：$JOBS_HOMEBREW_BIN"; return 1; }
}
# 只终止本次获取或等待创建的子进程树，不碰其它 SDK 写者。
jobs_brew_stop_acquisition_tree() {
  local root="$1" child=""
  for child in $(/usr/bin/pgrep -P "$root" 2>/dev/null); do
    jobs_brew_stop_acquisition_tree "$child"
  done
  /bin/kill -TERM "$root" 2>/dev/null || true
  /bin/kill -KILL "$root" 2>/dev/null || true
}
# 在本轮私有暂存目录持续获取固定官方 tag，复用已收对象；不重放安装。
jobs_brew_fetch_release() {
  setopt LOCAL_OPTIONS LOCAL_TRAPS NO_ERREXIT
  local git_bin="$1" release_tag="$2" stage="$3" target="${3}/brew"
  local attempt_log="${3}/git-fetch-attempt.log" history="${3}/git-fetch-history.log"
  local attempt=1 result=0 delay=1 task_pid="" interrupted=0 failure=""
  [[ "$release_tag" =~ '^[0-9]+\.[0-9]+\.[0-9]+$' && "$stage" == /* &&
     "${stage:t}" == .jobs-homebrew.* && -d "$stage" && ! -L "$stage" && ! -e "$target" && ! -L "$target" ]] || {
    jobs_brew_note 'Homebrew 获取版本或私有暂存路径无效，未执行 Git 获取。'
    return 2
  }
  "$git_bin" init --quiet "$target" || { result=$?; jobs_brew_note "Homebrew 暂存仓初始化失败（$result）：$target"; return "$result"; }
  "$git_bin" -C "$target" remote add origin https://github.com/Homebrew/brew.git || return $?
  trap 'interrupted=130; [[ -z "$task_pid" ]] || jobs_brew_stop_acquisition_tree "$task_pid"' INT
  trap 'interrupted=143; [[ -z "$task_pid" ]] || jobs_brew_stop_acquisition_tree "$task_pid"' TERM
  trap 'interrupted=129; [[ -z "$task_pid" ]] || jobs_brew_stop_acquisition_tree "$task_pid"' HUP
  while true; do
    jobs_brew_note "获取 Homebrew 官方版本 $release_tag（第 $attempt 次）：https://github.com/Homebrew/brew.git → $target；失败自动重试，Ctrl+C 取消。"
    : > "$attempt_log" || return 1
    print -r -- "━━ Homebrew $release_tag：第 $attempt 次 ━━" >> "$history" || return 1
    (
      local -a acquisition_statuses
      LC_ALL=C GIT_TERMINAL_PROMPT=0 "$git_bin" -C "$target" -c color.ui=false \
        -c http.lowSpeedLimit=1 -c http.lowSpeedTime=60 fetch --progress --depth 1 origin "refs/tags/$release_tag" 2>&1 |
        jobs_prompt_tee "$history" | jobs_prompt_tee "${LOG_FILE:-/dev/null}" | jobs_prompt_tee "$attempt_log" >&2
      acquisition_statuses=("${pipestatus[@]}")
      (( acquisition_statuses[2] == 0 && acquisition_statuses[3] == 0 && acquisition_statuses[4] == 0 )) || exit 74
      exit "${acquisition_statuses[1]}"
    ) <&0 &
    task_pid=$!
    result=0
    wait "$task_pid" || result=$?
    task_pid=""
    (( interrupted == 0 )) || return "$interrupted"
    jobs_brew_note "Homebrew $release_tag 获取第 $attempt 次退出码：$result。"
    if (( result == 0 )); then
      "$git_bin" -C "$target" checkout --quiet --detach FETCH_HEAD || return $?
      return 0
    fi
    case "$result" in
      74) jobs_brew_note "Homebrew 获取日志写入失败，停止；请检查磁盘空间、路径和权限。"; return 74 ;;
      129|130|131|137|143|126|127) return "$result" ;;
    esac
    failure="$(/usr/bin/tail -c 65536 "$attempt_log")" || return 1
    if print -r -- "$failure" | /usr/bin/grep -Eqi \
      'Permission denied|Operation not permitted|No space left on device|Read-only file system|File exists|already exists and is not an empty directory|Bad CPU type|Exec format error|unknown option|unrecognized option|invalid argument|couldn.t find remote ref|Remote branch .* not found|repository .* not found|Authentication failed|could not read Username|terminal prompts disabled|HTTP[^[:cntrl:]]*(401|403|404)|returned error: (401|403|404)|SSL certificate problem|certificate verify failed|unable to get local issuer certificate'; then
      jobs_brew_note "Homebrew 官方版本获取遇到本地、认证、证书或版本确定错误（$result），已停止；请核对日志：${LOG_FILE:-$history}。"
      return "$result"
    fi
    jobs_brew_note "Homebrew 网络获取尚未完成，保留本轮已收对象，${delay} 秒后继续；不设总次数或总时长上限，Ctrl+C 取消。"
    sleep "$delay" &
    task_pid=$!
    wait "$task_pid" || { result=$?; (( interrupted == 0 )) || return "$interrupted"; return "$result"; }
    task_pid=""
    (( interrupted == 0 )) || return "$interrupted"
    (( attempt += 1 ))
    (( delay >= 30 )) || delay=$(( delay * 2 ))
    (( delay <= 30 )) || delay=30
  done
}

# 获取固定官方稳定版本到用户目录；不覆盖非空目录，不调用 sudo。
jobs_brew_install_user() {
  local prefix="${JOBS_HOMEBREW_INSTALL_PREFIX:-$HOME/.local/homebrew}" stage release_tag git_bin release_result=0
  [[ "$prefix" == /* && "$prefix" != / && "$prefix" != *[[:space:]:]* ]] || {
    jobs_brew_note "Homebrew 用户前缀须为不含空白或冒号的绝对目录：$prefix"
    return 1
  }
  if [[ -L "$prefix" || ( -e "$prefix" && ! -d "$prefix" ) || ( -d "$prefix" && -n "$(ls -A "$prefix" 2>/dev/null)" ) ]]; then
    jobs_brew_note "用户安装目标非空或不是普通目录，不覆盖：$prefix"
    return 1
  fi
  local git_health=1 locate_result=0 git_candidate="" selected_developer="" clt_result=0 clt_diagnostic=""
  git_bin="$(command -v git 2>/dev/null)"
  # /usr/bin/git 可能只是CLT占位器；先查询真实工具，避免健康检查自行弹出安装窗口。
  if [[ "$git_bin" == /usr/bin/git || -z "$git_bin" ]]; then
    git_bin="$(/usr/bin/xcrun --find git 2>/dev/null)" || locate_result=$?
    case "$locate_result" in 129|130|131|137|143) return "$locate_result" ;; esac
  fi
  if [[ -n "$git_bin" && -x "$git_bin" ]]; then
    git_health=0;"$git_bin" --version >/dev/null 2>&1 || git_health=$?
    case "$git_health" in 129|130|131|137|143) return "$git_health" ;; esac
  fi
  if (( git_health != 0 )); then
    [[ -z "${DEVELOPER_DIR:-}" ]] || { jobs_brew_note '显式DEVELOPER_DIR没有健康Git，保留用户开发目录，未自动改全局选择。'; return 1; }
    locate_result=0
    selected_developer="$(/usr/bin/xcode-select -p 2>/dev/null)" || locate_result=$?
    case "$locate_result" in 129|130|131|137|143) return "$locate_result" ;; esac
    if [[ -n "$selected_developer" && -d "$selected_developer" ]]; then
      jobs_brew_note "既有开发目录未提供健康Git：$selected_developer；可能是许可、版本或本地文件阻塞，未反复安装或改全局xcode-select。"
      return 1
    fi
    if [[ "${DRY_RUN:-0}" == 1 || "${CHECK_ONLY:-0}" == 1 || ! -t 0 || ! -t 2 || "${IS_SOURCETREE_RUNTIME:-0}" == 1 ]] ||
       env | LC_ALL=C /usr/bin/grep -qiE '^(SOURCETREE|SOURCE_TREE)'; then
      jobs_brew_note '用户目录Homebrew需要健康Git；当前为只读或非交互入口，未打开CLT安装窗口或写安装目标。'
      return 1
    fi
    jobs_brew_note '当前已选用户目录Homebrew安装需要Apple Command Line Tools的Git；只打开一次原生安装窗口，许可由本人处理，当前流程持续复检，Ctrl+C停止。' || return $?
    clt_diagnostic="$(/usr/bin/xcode-select --install 2>&1)" || clt_result=$?
    jobs_brew_note "$clt_diagnostic" || return $?
    if (( clt_result != 0 )) && [[ "$clt_diagnostic" != *'already being installed'* && "$clt_diagnostic" != *'正在安装'* ]]; then return "$clt_result"; fi
    while true; do
      locate_result=0
      git_candidate="$(/usr/bin/xcrun --find git 2>/dev/null)" || locate_result=$?
      case "$locate_result" in 129|130|131|137|143) return "$locate_result" ;; esac
      if [[ -n "$git_candidate" && -x "$git_candidate" ]]; then
        git_health=0;"$git_candidate" --version >/dev/null 2>&1 || git_health=$?
        case "$git_health" in 129|130|131|137|143) return "$git_health" ;; esac
        if (( git_health == 0 )); then git_bin="$git_candidate";break;fi
      fi
      jobs_brew_note '等待Apple CLT提供健康Git；不会重复打开窗口，Ctrl+C停止。' || return $?
      /bin/sleep 3 || return $?
    done
  fi
  command -v curl >/dev/null 2>&1 || { jobs_brew_note "缺少 curl，无法获取官方稳定版本。"; return 1; }
  export HOMEBREW_NO_SUDO=1
  mkdir -p "${prefix:h}" || return 1
  stage="$(mktemp -d "${prefix:h}/.jobs-homebrew.XXXXXX")" || return 1
  if jobs_brew_download_file "$stage/release.json" 'Homebrew 官方稳定版本' \
      https://api.github.com/repos/Homebrew/brew/releases/latest; then
    release_result=0
  else
    release_result=$?
    rm -r -- "$stage"
    jobs_brew_note "获取官方稳定版本已停止（退出码 $release_result），未执行安装。"
    return "$release_result"
  fi
  release_tag="$(sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([0-9][0-9.]*\)".*/\1/p' "$stage/release.json" | head -n 1)"
  if [[ ! "$release_tag" =~ '^[0-9]+\.[0-9]+\.[0-9]+$' ]]; then
    rm -r -- "$stage"
    jobs_brew_note '官方版本响应无有效 tag，停止；不重试版本解析或执行安装。'
    return 1
  fi
  if jobs_brew_fetch_release "$git_bin" "$release_tag" "$stage"; then
    release_result=0
  else
    release_result=$?
    rm -r -- "$stage"
    jobs_brew_note "Homebrew 官方版本获取已停止（退出码 $release_result），未执行安装。"
    return "$release_result"
  fi
  if ! "$git_bin" -C "$stage/brew" checkout -b stable ||
     ! "$git_bin" -C "$stage/brew" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*' ||
     ! mkdir -p "$stage/brew/Cellar" "$stage/brew/Caskroom" "$stage/brew/etc" "$stage/brew/var"; then
    rm -r -- "$stage"
    jobs_brew_note "Homebrew 用户目录初始化失败，停止安装。"
    return 1
  fi
  # 空目录也只在下载成功后移除，避免提前改动用户的目标目录。
  if [[ -d "$prefix" ]] && ! rmdir -- "$prefix"; then
    rm -r -- "$stage"
    return 1
  fi
  if ! mv "$stage/brew" "$prefix"; then
    rm -r -- "$stage"
    return 1
  fi
  rm -r -- "$stage"
  typeset -g JOBS_HOMEBREW_BIN="$prefix/bin/brew"
  jobs_brew_candidate_ok "$JOBS_HOMEBREW_BIN" || { jobs_brew_note "用户目录安装后复检失败：$prefix"; return 1; }
}
# 只更新本模块的 shellenv 配置块，并保留配置文件的符号链接和权限。
# 激活当前进程并验证 Ruby 命令层；只有新安装才持久化 shellenv。
jobs_brew_activate() {
  local brew_env
  brew_env="$("$JOBS_HOMEBREW_BIN" shellenv)" || return 1
  eval "$brew_env" || return 1
  typeset -g JOBS_HOMEBREW_PREFIX="$("$JOBS_HOMEBREW_BIN" --prefix)"
  export PATH="$JOBS_HOMEBREW_PREFIX/bin:$JOBS_HOMEBREW_PREFIX/sbin:$PATH"
  rehash
  HOMEBREW_NO_AUTO_UPDATE=1 "$JOBS_HOMEBREW_BIN" config >/dev/null || { jobs_brew_note "Homebrew 命令层复检失败，停止后续业务。"; return 1; }
  if [[ "${1:-}" == installed ]]; then
    if [[ "${JOBS_HOMEBREW_INSTALL_MODE:-}" == user && -z "${HOMEBREW_CASK_OPTS:-}" ]]; then
      export HOMEBREW_CASK_OPTS="--appdir=$HOME/Applications"
    fi
    # 只刷新本次进程，不向用户 Shell 启动文件写入持久配置。
    :
  fi
}
# 用户取消保持信号退出码，其它安装失败沿用原入口失败状态。
jobs_brew_stop_failed_install() {
  case "$1" in
    129|130|143) exit "$1" ;;
    *) exit 1 ;;
  esac
}

# 编排既有健康复用和已选安装路径，失败保留原生取消状态。
jobs_brew_install_or_exit() {
  local installed=""
  if [[ "${DRY_RUN:-0}" == 1 ]]; then
    jobs_brew_note "演练：Homebrew 系统路径 $(jobs_brew_system_prefix)；用户路径 ${JOBS_HOMEBREW_INSTALL_PREFIX:-$HOME/.local/homebrew}；未询问或执行安装。"
    return 0
  fi
  if ! JOBS_HOMEBREW_BIN="$(jobs_brew_find)"; then
    jobs_brew_choose_installation || exit 1
    case "$JOBS_HOMEBREW_INSTALL_MODE" in
      system) jobs_brew_install_system || jobs_brew_stop_failed_install $? ;;
      user) jobs_brew_install_user || jobs_brew_stop_failed_install $? ;;
      *) jobs_brew_note "安装路径选择无效，停止。"; exit 1 ;;
    esac
    installed=installed
  fi
  jobs_brew_activate "$installed" || exit 1
}

# 将依赖诊断写到人类展示流，避免混入选择结果。
jobs_fzf_note() {
  if (( ${+functions[jobs_prompt_output]} )); then
    jobs_prompt_output print -u2 -r -- "$*"
  else
    print -u2 -r -- "$*"
  fi
  if [[ -n "${LOG_FILE:-}" ]]; then print -r -- "$*" >> "$LOG_FILE"; fi
}
# 只给健康探针设置单次上限；下载获取仍由持续重试流程负责。
jobs_fzf_bounded_probe() {
  local child=0 watchdog=0 result=0
  "$@" <&0 &
  child=$!
  ( /bin/sleep 10; jobs_brew_stop_acquisition_tree "$child" ) >/dev/null 2>&1 &
  watchdog=$!
  wait "$child" || result=$?
  jobs_brew_stop_acquisition_tree "$watchdog"
  wait "$watchdog" 2>/dev/null || :
  return "$result"
}
# 验证可执行路径、版本和本轮菜单实际使用的选项；不打开选择面板。
jobs_fzf_probe() {
  local candidate="$1" probe='__JOBS_FZF_HEALTH__' output="" result=0
  [[ -n "$candidate" && -x "$candidate" && ! -d "$candidate" ]] || return 1
  jobs_fzf_bounded_probe /usr/bin/env -u FZF_DEFAULT_OPTS -u FZF_DEFAULT_OPTS_FILE -u FZF_DEFAULT_COMMAND "$candidate" --version >/dev/null 2>&1 || return 1
  output="$(print -r -- "P"$'\t'"$probe" | jobs_fzf_bounded_probe /usr/bin/env -u FZF_DEFAULT_OPTS -u FZF_DEFAULT_OPTS_FILE -u FZF_DEFAULT_COMMAND \
    "$candidate" --filter="$probe" --delimiter=$'\t' --with-nth=2.. --no-multi --sync --print-query --layout=reverse --height=60% --border \
      --bind='up:up,down:down,tab:down,shift-tab:up' --expect=left --header='↑/↓ 选择；回车确认；← 返回上一层；Esc / Ctrl+C 取消')" || result=$?
  (( result == 0 )) && [[ "${output##*$'\n'}" == P$'\t'"$probe" ]]
}
# 从当前进程和常见安装位置复用真正健康的 fzf，不重复安装。
jobs_fzf_find() {
  local candidate=""
  local -a candidates=("${JOBS_FZF_BIN:-}" "${commands[fzf]:-}" /opt/homebrew/bin/fzf /usr/local/bin/fzf "$HOME/.local/bin/fzf")
  for candidate in "${candidates[@]}"; do
    if jobs_fzf_probe "$candidate"; then JOBS_FZF_BIN="${candidate:A}"; return 0; fi
  done
  return 1
}
# 只读检查不修复；已确认业务仅在缺失或损坏时补齐选择器并刷新当前进程。
jobs_fzf_ensure() {
  local mode="${1:-required}" brew="" action=install result=0 attempt=0 delay=1 output_log="" prefix="" offset=0 log_result=0
  local -a command_status
  if [[ "$mode" != check ]] && { [[ ! -t 0 || ! -t 2 ]] || [[ "${IS_SOURCETREE_RUNTIME:-0}" == 1 ]]; }; then
    print -u2 -r -- '✖ 选择器需要可交互终端；未安装依赖或执行后续业务。'
    return 1
  fi
  if jobs_fzf_find; then
    if [[ "$mode" != check ]]; then export PATH="${JOBS_FZF_BIN:h}:$PATH"; rehash; fi
    return 0
  fi
  [[ "$mode" != check ]] || { print -u2 -r -- '✖ fzf 路径、版本或菜单选项检查失败；只读模式未安装或修复。'; return 1; }
  jobs_fzf_note '➤ 本次键盘选择需要健康 fzf；仅在缺失或损坏时通过 Homebrew 准备，Ctrl+C 可取消。' || return $?
  jobs_brew_install_or_exit >&2 || return $?
  brew="${JOBS_HOMEBREW_BIN:-}"
  [[ -n "$brew" ]] || { jobs_fzf_note '✖ Homebrew 准备未返回可执行路径。'; return 1; }
  prefix="$("$brew" --prefix)" || return $?
  export PATH="$prefix/bin:$prefix/sbin:$PATH"
  rehash
  output_log="${LOG_FILE:-${TMPDIR:-/tmp}/JobsFzf.$$.log}"
  HOMEBREW_NO_AUTO_UPDATE=1 "$brew" list --versions fzf >/dev/null 2>&1 && action=reinstall
  while true; do
    (( attempt += 1 ))
    jobs_fzf_note "➤ 必需依赖 fzf｜来源：https://formulae.brew.sh/formula/fzf｜目标：$prefix｜$action，第 $attempt 次；网络失败持续重试，Ctrl+C 结束。" || return $?
    offset=0
    [[ ! -f "$output_log" ]] || offset="$(/usr/bin/wc -c < "$output_log")"
    HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_INSTALL_CLEANUP=1 "$brew" "$action" fzf 2>&1 | jobs_prompt_tee "$output_log" >&2
    command_status=("${pipestatus[@]}")
    result=${command_status[1]}
    log_result=${command_status[2]}
    if (( log_result != 0 )); then print -u2 -r -- "✖ fzf 输出记录失败，退出码 $log_result；未继续重试或报告就绪。"; return "$log_result"; fi
    if (( result == 0 )); then
      rehash
      if jobs_fzf_find; then jobs_fzf_note "✔ fzf 已通过版本与菜单选项复检：$JOBS_FZF_BIN"; return 0; fi
      jobs_fzf_note '✖ 安装器返回成功，但 fzf 仍未通过实际选项复检；保留日志并停止，未进入业务。'
      return 1
    fi
    case "$result" in 129|130|137|143) return "$result" ;; esac
    if /usr/bin/tail -c +$((offset + 1)) "$output_log" | /usr/bin/tail -c 65536 | /usr/bin/grep -Eqi 'Permission denied|Operation not permitted|No space left|No available formula|No formulae found|File exists|unsupported|not supported|license.*(not accepted|rejected)|authentication failed|certificate.*(invalid|verify failed)'; then
      jobs_fzf_note "✖ 必需依赖遇到确定的本地、版本、认证或许可阻塞，退出码 $result；日志：$output_log"
      return "$result"
    fi
    jobs_fzf_note "⚠ fzf 获取失败，退出码 $result；${delay} 秒后继续同一流程。日志：$output_log" || return $?
    /bin/sleep "$delay" || return $?
    (( delay < 30 )) && delay=$(( delay * 2 > 30 ? 30 : delay * 2 ))
  done
}
# 单选默认取消，操作行与业务数据分开；返回、取消和失败分别传播。
jobs_fzf_pick() {
  local title="$1" level="${2:-root}" selected="" result=0 record="" key="" choice="" index=0 header=""
  shift 2
  local -a choices=("$@") menu=($'C\t× 取消本轮')
  JOBS_FZF_SELECTED=""
  JOBS_FZF_QUERY="${JOBS_FZF_INITIAL_QUERY:-}"
  (( ${#choices[@]} )) || return 1
  for choice in "${choices[@]}"; do
    [[ "$choice" != *$'\n'* && "$choice" != *$'\r'* ]] || { jobs_fzf_note '✖ 候选包含换行，停止以避免错误映射。'; return 1; }
  done
  local force=0
  if [[ "$level" == confirm-* ]]; then force=1; level="${level#confirm-}"; JOBS_FZF_QUERY=""; fi
  if [[ "$level" == force-* ]]; then force=1; level="${level#force-}"; fi
  if (( ${#choices[@]} == 1 && ! force )); then JOBS_FZF_SELECTED="${choices[1]}"; return 0; fi
  jobs_fzf_ensure >&2 || return $?
  if [[ "$level" == root ]]; then
    header='↑/↓ 或 Tab 选择；回车确认；← / Esc / Ctrl+C 取消'
  else
    menu+=($'B\t← 返回上一层')
    header='↑/↓ 或 Tab 选择；回车确认；← 返回上一层；Esc / Ctrl+C 取消'
  fi
  for choice in "${choices[@]}"; do
    [[ "$choice" != *$'\n'* && "$choice" != *$'\r'* ]] || { jobs_fzf_note '✖ 候选包含换行，停止以避免错误映射。'; return 1; }
    (( index += 1 ))
    menu+=("D${index}"$'\t'"$choice")
  done
  selected="$(print -rl -- "${menu[@]}" | /usr/bin/env -u FZF_DEFAULT_OPTS -u FZF_DEFAULT_OPTS_FILE -u FZF_DEFAULT_COMMAND \
    "$JOBS_FZF_BIN" --no-multi --sync --print-query --query="$JOBS_FZF_QUERY" --layout=reverse --height=60% --border --delimiter=$'\t' --with-nth=2.. --prompt="$title > " \
      --bind='up:up,down:down,tab:down,shift-tab:up' --expect=left --header="$header")" || result=$?
  if [[ "$selected" == *$'\n'* ]]; then
    JOBS_FZF_QUERY="${selected%%$'\n'*}"
    selected="${selected#*$'\n'}"
    key="${selected%%$'\n'*}"
    record="${selected#*$'\n'}"
  fi
  if [[ "$key" == left ]]; then
    [[ "$level" == root ]] && return 130 || return 20
  fi
  (( result == 0 )) || { (( result == 1 || result == 130 )) && return 130; return "$result"; }
  key="${record%%$'\t'*}"
  [[ -n "$record" && "$key" != C ]] || return 130
  [[ "$key" != B ]] || return 20
  [[ "$key" == D<-> ]] || { jobs_fzf_note '✖ 选择器返回无效操作标记。'; return 1; }
  index="${key#D}"
  (( index >= 1 && index <= ${#choices[@]} )) && [[ "$record" == "D${index}"$'\t'"${choices[index]}" ]] || {
    jobs_fzf_note '✖ 选择器返回了不属于当前清单的数据。'; return 1
  }
  JOBS_FZF_SELECTED="${choices[index]}"
  return 0
}
# 按真实候选集记住本层查询；返回保留，候选改变后清空，确认菜单不复用查询。
jobs_fzf_menu() {
  local title="$1" level="${2:-root}" result=0 cache_key="" signature=""
  shift 2
  local -a choices=("$@")
  typeset -gA JOBS_FZF_SAVED_QUERIES JOBS_FZF_SAVED_ROWS
  cache_key="$level"$'\x1f'"$title"
  signature="${(F)choices}"
  local JOBS_FZF_INITIAL_QUERY=""
  if [[ "${JOBS_FZF_SAVED_ROWS[$cache_key]-}" == "$signature" ]]; then
    JOBS_FZF_INITIAL_QUERY="${JOBS_FZF_SAVED_QUERIES[$cache_key]-}"
  fi
  jobs_fzf_pick "$title" "force-$level" "${choices[@]}" || result=$?
  JOBS_FZF_SAVED_ROWS[$cache_key]="$signature"
  JOBS_FZF_SAVED_QUERIES[$cache_key]="$JOBS_FZF_QUERY"
  return "$result"
}
# 为单层旧调用保留纯数据 stdout；多层调用直接使用 pick 的结果和查询字段。
jobs_fzf_choose() {
  jobs_fzf_pick "$@" || return $?
  print -r -- "$JOBS_FZF_SELECTED"
}
# JOBS_FZF_REQUIRED_END

choose_entry() {
  local title="$1" allow_back="$2" result=0 level=root entry=""
  shift 2
  local -a entries=()
  for entry in "$@"; do [[ -z "$entry" ]] || entries+=("$entry"); done
  SELECTION=""
  (( ${#entries} )) || { error_echo "没有可供选择的记录：$title"; return 1; }
  (( ! allow_back )) || level=child
  jobs_fzf_menu "$title" "$level" "${entries[@]}" || result=$?
  (( result != 20 )) || return 10
  (( result != 130 )) || return 0
  (( result == 0 )) || return "$result"
  SELECTION="$JOBS_FZF_SELECTED"
}
# 提交列表首列始终为完整 hash，不从图形线条里猜目标。
perform_selected_reset() {
  local -a records=()
  case "$RESET_MODE" in
    'soft 回退到 upstream') reset_soft_to_remote ;;
    'hard 回退到 upstream')
      resolve_upstream_target || return $?
      confirm_and_reset_hard "$RESET_TARGET" "$UPSTREAM_REF"
      ;;
    '选择提交 soft 回退'|'选择提交 hard 回退')
      records=("${(@f)$(git -C "$REPO_ROOT" log --all --format='%H %s' --max-count=200)}")
      choose_entry "选择回退后保留的提交" 1 "${records[@]}" || return $?
      [[ -n "$SELECTION" ]] || return 0
      if [[ "$RESET_MODE" == '选择提交 soft 回退' ]]; then
        RESET_TARGET="${SELECTION%% *}"
        reset_soft_to_target "$SELECTION"
      else
        confirm_and_reset_hard "${SELECTION%% *}" "$SELECTION"
      fi
      ;;
    '选择 tag hard 回退')
      records=("${(@f)$(git -C "$REPO_ROOT" tag --sort=-creatordate)}")
      choose_entry "选择 tag" 1 "${records[@]}" || return $?
      [[ -n "$SELECTION" ]] || return 0
      confirm_and_reset_hard "refs/tags/${SELECTION}" "$SELECTION"
      ;;
    '选择 reflog hard 回退')
      records=("${(@f)$(git -C "$REPO_ROOT" reflog --format='%H %gd %gs' --max-count=200)}")
      choose_entry "选择 reflog" 1 "${records[@]}" || return $?
      [[ -n "$SELECTION" ]] || return 0
      confirm_and_reset_hard "${SELECTION%% *}" "$SELECTION"
      ;;
    *) info_echo "已取消回退。" ;;
  esac
}
# 返回键只重进模式层，取消不会执行后续回退。
run_interactive_reset() {
  local result=0
  local -a modes=('soft 回退到 upstream' '选择提交 soft 回退')
  [[ "$TERMINAL_SOFT" == 1 ]] || modes+=('hard 回退到 upstream' '选择提交 hard 回退' '选择 tag hard 回退' '选择 reflog hard 回退')
  while true; do
    choose_entry '选择回退模式' 0 "${modes[@]}" || return $?
    [[ -n "$SELECTION" ]] || { info_echo '已取消回退。'; return 0; }
    RESET_MODE="$SELECTION"
    result=0
    perform_selected_reset || result=$?
    [[ "$result" != 10 ]] || continue
    [[ "$result" != 20 ]] || { info_echo '已取消回退。'; return 0; }
    return "$result"
  done
}
# 使用 argv 与 shell 引号承接明确仓库，终端回退仍需确认和选择。
open_terminal_for_selection() {
  /usr/bin/osascript - "$SCRIPT_PATH" "$REPO_ROOT" <<'APPLESCRIPT'
on run argv
  set shellCommand to "/bin/zsh " & quoted form of item 1 of argv & " --terminal-soft " & quoted form of item 2 of argv & "; jobs_reset_result=$?; printf '\\n提交回退结束，退出码：%s\\n' \"$jobs_reset_result\""
  tell application "Terminal"
    activate
    do script shellCommand
  end tell
end run
APPLESCRIPT
  local launch_result=$?
  (( launch_result == 0 )) || { error_echo 'Terminal 启动失败；仓库未回退，请在终端手动运行。'; return "$launch_result"; }
  jobs_prompt_output info_echo '已转交 Terminal；回车确认后选择回退模式与目标，最终结果在新终端查看。'
}
# 各线路当前分支快照不一致时不能仅按默认 upstream 解释全部推送状态。
dispatch_multiremote_selection() {
  [[ "$IS_SOURCETREE_RUNTIME" == 1 && -z "$REQUESTED_UPSTREAM_REF" ]] || return 0
  collect_upstream_choices
  local ref="" commit=""
  local -a commits=()
  for ref in "${UPSTREAM_CHOICES[@]}"; do
    commit="$(git -C "$REPO_ROOT" rev-parse "$ref")"
    commits+=("$commit")
  done
  commits=("${(@u)commits}")
  (( ${#commits[@]} > 1 )) || return 0
  warn_echo '检测到多条远端线路的本地快照不同；请明确选择，当前还没有执行 reset。'
  for ref in "${UPSTREAM_CHOICES[@]}"; do
    info_echo "${ref} [$(git -C "$REPO_ROOT" rev-parse --short "$ref")]"
  done
  open_terminal_for_selection || exit $?
  exit 0
}
run_reset_workflow() {
  if [[ "$IS_SOURCETREE_RUNTIME" == 1 ]]; then
    reset_soft_to_remote
  else
    run_interactive_reset
  fi
}
print_completion() {
  success_echo "提交回退流程结束；日志：${LOG_FILE}"
}
main() {
  show_script_intro_and_wait "$@" # 首屏自述与确认，Sourcetree 仅跳过入口确认。
  initialize_script_runtime # 确认后准备日志与 Shell 选项。
  isolate_git_context # 隔离继承的 Git 仓库定位变量，保护明确选定的工作树。
  check_environment # 验证 Git 可用。
  parse_arguments "$@" # 解析仓库和显式远端快照，不猜最近失败线路。
  resolve_repository "$REPO_ARGUMENT" # 使用指定工作树，避免误处理外层仓库。
  check_repository_state # 冲突、锁与未完成操作阻止重置。
  dispatch_multiremote_selection # Sourcetree 多线路不一致时转交终端明确选择。
  run_reset_workflow # Sourcetree 执行安全 soft 模式，终端允许选择并确认 hard 模式。
  print_completion # 业务成功后输出结果与日志位置。
}

main "$@"
