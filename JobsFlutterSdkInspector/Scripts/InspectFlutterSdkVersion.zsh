# 先记录 FVM 声明版本，再判断它是否已经通过 .fvm/flutter_sdk 真正生效。
fsi_resolve_sdk_source() {
    fsi_read_fvm_config || true
    if fsi_resolve_project_fvm_sdk; then
        return 0
    fi
    if [[ -n "$FSI_FVM_CONFIG" ]]; then
        if [[ -n "$FSI_FVM_PINNED" ]]; then
            fsi_log "⚠ .fvmrc 已指定 $FSI_FVM_PINNED，但项目 .fvm/flutter_sdk 尚未链接或不可用；本次显示的是系统 Flutter SDK。请在终端执行 fvm use <版本> 后再查询。"
        else
            fsi_log '⚠ 存在 FVM 配置但没有指定具体版本，也没有可用的 .fvm/flutter_sdk；本次显示的是系统 Flutter SDK。'
        fi
    else
        fsi_log 'ℹ 项目不由 FVM 管理（缺少 .fvmrc / .fvm/fvm_config.json）；本次显示的是系统 Flutter SDK。'
    fi
    fsi_resolve_system_sdk || fsi_fail '未找到可执行的 Flutter SDK。请先安装 Flutter 或用 FVM 安装版本；本脚本不自动安装 SDK'
}
# 按字节刷新日志，保留原生回车进度与尚未换行的输出。
fsi_stream_probe_output() {
    local chunk=""
    while sysread -i "$1" -s 65536 chunk; do
        if [[ -n "${2:-}" ]]; then
            print -rn -- "$chunk" | /usr/bin/tee -a "$2"
        else
            print -rn -- "$chunk"
        fi
    done
}
# 有界探测保留独立机器输出；冷启动补缓存时同步显示两路原始进度。
fsi_probe_with_timeout() {
    local executable="$1" seconds="$2" pid="" waited=0 result=0 output_fd="" error_fd=""
    zmodload zsh/system || return 1
    : > "$FSI_MACHINE_FILE.raw" && : > "$FSI_MACHINE_FILE.stderr" || return 1
    exec {output_fd}< "$FSI_MACHINE_FILE.raw" || return 1
    exec {error_fd}< "$FSI_MACHINE_FILE.stderr" || { exec {output_fd}<&-; return 1; }
    ( exec "$executable" --version --machine ) > "$FSI_MACHINE_FILE.raw" 2> "$FSI_MACHINE_FILE.stderr" &
    pid=$!
    while (( waited < seconds )) && /bin/kill -0 "$pid" 2>/dev/null; do
        fsi_stream_probe_output "$output_fd"
        fsi_stream_probe_output "$error_fd" "$FSI_LOG_FILE" >&2
        /bin/sleep 1
        waited=$(( waited + 1 ))
    done
    if /bin/kill -0 "$pid" 2>/dev/null; then
        jfs_route_stop_tree "$pid"
        /bin/sleep 1
        wait "$pid" 2>> "$FSI_LOG_FILE" || true
        result=124
    else
        wait "$pid" 2>> "$FSI_LOG_FILE" || result=$?
    fi
    fsi_stream_probe_output "$output_fd"
    fsi_stream_probe_output "$error_fd" "$FSI_LOG_FILE" >&2
    exec {output_fd}<&-
    exec {error_fd}<&-
    (( result != 124 )) || fsi_log "⚠ SDK 版本查询超时（${seconds}s），已停止候选：$executable"
    return "$result"
