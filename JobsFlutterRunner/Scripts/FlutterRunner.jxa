// 内部数据助手：解析 Flutter / simctl JSON、校验 pubspec，并生成本次 launchd 配置。
// 仅由运行器以独立参数调用；不启动应用、不安装工具、不执行 Shell 拼接命令。

ObjC.import('Foundation');

// 将菜单展示字段变成单行，防止控制字符破坏 TSV 与终端显示。
function field(value) {
    return String(value === undefined || value === null ? '' : value)
        .replace(/[\u0000-\u001f\u007f-\u009f]/g, ' ')
        .trim();
}
// 查询路径自身属性，保留符号链接身份供调用方拒绝。
function attributes(path) {
    var value = $.NSFileManager.defaultManager.attributesOfItemAtPathError($(path), null);
    return value ? ObjC.deepUnwrap(value) : null;
}
// 读取 UTF-8 普通文件，限制外部清单大小且不跟随末级符号链接。
function readText(path, limit) {
    var info = attributes(path);
    if (!info || info.NSFileType !== 'NSFileTypeRegular' || info.NSFileSize > limit) {
        throw new Error('文件不可读、不是普通文件或超过大小限制：' + field(path));
    }
    var value = $.NSString.stringWithContentsOfFileEncodingError($(path), $.NSUTF8StringEncoding, null);
    if (!value) {
        throw new Error('文件不是有效 UTF-8：' + field(path));
    }
    return ObjC.unwrap(value);
}
// 将 JSON 输入错误明确传回终端，避免把解析失败伪装成无设备。
function readJSON(path) {
    return JSON.parse(readText(path, 16 * 1024 * 1024));
}
// 保留设备标识原值；非正常单行标识不能成为可执行目标。
function identifier(value) {
    return typeof value === 'string' && value.length > 0 && !/[\u0000-\u0020\u007f-\u009f]/.test(value)
        ? value : null;
}
// 已知平台必须有项目对应平台目录，自定义设备平台保持兼容。
function projectSupportsPlatform(project, targetPlatform) {
    if (!project) {
        return true;
    }
    var platform = String(targetPlatform || '').toLowerCase();
    var directory = null;
    if (/^android/.test(platform)) {
        directory = 'android';
    } else if (/^ios/.test(platform)) {
        directory = 'ios';
    } else if (/^(darwin|macos)/.test(platform)) {
        directory = 'macos';
    } else if (/^web/.test(platform)) {
        directory = 'web';
    } else if (/^linux/.test(platform)) {
        directory = 'linux';
    } else if (/^windows/.test(platform)) {
        directory = 'windows';
    }
    if (!directory) {
        return true;
    }
    var value = attributes(project.replace(/\/+$/, '') + '/' + directory);
    return !!value && value.NSFileType === 'NSFileTypeDirectory';
}
// 只列出 Flutter 当前支持且项目已配置平台的真实设备，输出两列 TSV。
function devices(path, project) {
    var values = readJSON(path);
    if (!Array.isArray(values)) {
        throw new Error('Flutter 设备响应必须是数组。');
    }
    var seen = Object.create(null);
    return values.filter(function (value) {
        if (!value || value.supported === false || value.isSupported === false || !identifier(value.id) || seen[value.id]
            || !projectSupportsPlatform(project, value.targetPlatform || value.platform)) {
            return false;
        }
        seen[value.id] = true;
        return true;
    }).map(function (value) {
        var platform = field(value.targetPlatform || value.platform || value.category || '平台未知');
        return value.id + '\t' + field(value.name || value.id) + ' — ' + platform;
    }).join('\n');
}
// 兼容外部提供的官方 daemon emulator 结果数组，只列出已有 Android AVD。
function emulators(path) {
    var values = readJSON(path);
    if (!Array.isArray(values)) {
        throw new Error('模拟器响应必须是数组。');
    }
    var seen = Object.create(null);
    return values.filter(function (value) {
        if (!value || String(value.platformType || '').toLowerCase() !== 'android'
            || !identifier(value.id) || seen[value.id]) {
            return false;
        }
        seen[value.id] = true;
        return true;
    }).map(function (value) {
        return value.id + '\t' + field(value.name || value.id) + ' — Android';
    }).join('\n');
}
// 兼容 simctl 现行布尔标志与旧版 availability 描述。
function available(value) {
    if (typeof value.isAvailable === 'boolean') {
        return value.isAvailable;
    }
    return typeof value.availability === 'string' && /\bavailable\b/i.test(value.availability)
        && !/unavailable/i.test(value.availability);
}
// 验证 simctl 总清单结构，拒绝损坏的运行时 / 设备容器。
function simulatorData(path) {
    var value = readJSON(path);
    if (!value || !Array.isArray(value.runtimes) || !Array.isArray(value.devicetypes)
        || !value.devices || Array.isArray(value.devices) || typeof value.devices !== 'object') {
        throw new Error('simctl 响应缺少 runtimes、devicetypes 或 devices。');
    }
    return value;
}
// 只接受安装且可用的 iOS runtime，按版本从新到旧列出。
function iosRuntimes(data) {
    return data.runtimes.filter(function (value) {
        return value && identifier(value.identifier) && available(value)
            && /^com\.apple\.CoreSimulator\.SimRuntime\.iOS[-.]/.test(value.identifier);
    }).sort(function (left, right) {
        var a = String(left.version || '').split('.').map(Number);
        var b = String(right.version || '').split('.').map(Number);
        for (var index = 0; index < Math.max(a.length, b.length); index += 1) {
            var difference = (b[index] || 0) - (a[index] || 0);
            if (difference) {
                return difference;
            }
        }
        return field(left.identifier).localeCompare(field(right.identifier));
    });
}
// 列出 iOS runtime 中可用模拟器，运行中的设备优先显示。
function simulators(path) {
    var data = simulatorData(path);
    var rows = [];
    var seen = Object.create(null);
    iosRuntimes(data).forEach(function (runtime) {
        var values = data.devices[runtime.identifier];
        if (!Array.isArray(values)) {
            return;
        }
        values.forEach(function (value) {
            if (!value || !available(value) || !identifier(value.udid) || seen[value.udid]) {
                return;
            }
            seen[value.udid] = true;
            rows.push({ id: value.udid, state: value.state, display: field(value.name || value.udid)
                + ' — ' + field(value.state || '状态未知') + ' — ' + field(runtime.name || runtime.identifier) });
        });
    });
    rows.sort(function (left, right) {
        return Number(right.state === 'Booted') - Number(left.state === 'Booted');
    });
    return rows.map(function (value) { return value.id + '\t' + value.display; }).join('\n');
}
// 将创建模拟器可用的 iOS runtime 输出为两列 TSV。
function runtimes(path) {
    var seen = Object.create(null);
    return iosRuntimes(simulatorData(path)).filter(function (value) {
        var key = field(value.version) + '\t' + field(value.name || value.identifier);
        if (seen[key]) {
            return false;
        }
        seen[key] = true;
        return true;
    }).map(function (value) {
        return value.identifier + '\t' + field(value.name || value.identifier);
    }).join('\n');
}
// 仅保留具名 iPhone 机型，避免误建成 watchOS / tvOS 设备。
function iphoneTypes(data) {
    var seen = Object.create(null);
    return data.devicetypes.filter(function (value) {
        if (!value || !identifier(value.identifier) || seen[value.identifier]
            || !(value.productFamily === 'iPhone' || /^iPhone(?:\s|$)/.test(String(value.name || '')))) {
            return false;
        }
        seen[value.identifier] = true;
        return true;
    });
}
// 列出 iPhone 机型供内置初始化使用；第二列只用于展示。
function deviceTypes(path) {
    return iphoneTypes(simulatorData(path)).map(function (value) {
        return value.identifier + '\t' + field(value.name || value.identifier);
    }).join('\n');
}
// iOS runtime 标识中的版本换成可比较整数，便于按新旧排序。
function versionNumber(value) {
    var match = /^(\d+)(?:\.(\d+))?(?:\.(\d+))?$/.exec(String(value === undefined || value === null ? '' : value).trim());
    if (!match) {
        return -1;
    }
    return Number(match[1]) * 65536 + Number(match[2] || 0) * 256 + Number(match[3] || 0);
}
// 只保留当前架构支持的 runtime；字段缺失或为空时不据此排除。
function iosRuntimesForArchitecture(data, arch) {
    return iosRuntimes(data).filter(function (value) {
        var architectures = value.supportedArchitectures;
        return !Array.isArray(architectures) || architectures.length === 0
            || architectures.indexOf(arch) >= 0;
    });
}
// 兼容白名单；字段缺失或空数组表示没有结论，交由版本范围判断。
function supportIdentifiers(runtime) {
    var supported = runtime.entry.supportedDeviceTypes;
    if (!Array.isArray(supported) || supported.length === 0) {
        return null;
    }
    return supported.map(function (entry) {
        var value = (entry && typeof entry === 'object') ? entry.identifier : entry;
        return identifier(value) && value.indexOf('com.apple.CoreSimulator.SimDeviceType.') === 0
            ? value : null;
    });
}
// 型号的系统上下限，同时兼容数值与字符串两种 simctl 写法。
function runtimeBound(device, prefix) {
    var value = device[prefix + 'RuntimeVersion'];
    if (typeof value === 'number' && isFinite(value) && value >= 0 && Math.floor(value) === value) {
        return value;
    }
    value = device[prefix + 'RuntimeVersionString'];
    var parsed = versionNumber(value);
    return parsed >= 0 ? parsed : null;
}
// 组合结论：2 已确认支持，1 未知，0 明确不支持；只排除有明确依据的组合。
function compatibility(device, runtime) {
    var identifiers = supportIdentifiers(runtime);
    if (identifiers) {
        if (identifiers.indexOf(device.identifier) >= 0) {
            return 2;
        }
        if (identifiers.every(function (value) { return value !== null; })) {
            return 0;
        }
    }
    var minimum = runtimeBound(device, 'min');
    var maximum = runtimeBound(device, 'max');
    if (minimum !== null && maximum !== null && minimum > maximum) {
        return 1;
    }
    if (minimum !== null && runtime.value < minimum) {
        return 0;
    }
    if (maximum !== null && runtime.value > maximum) {
        return 0;
    }
    return 1;
}
// 保留完整型号，把本机有可搭配系统的型号排前面，避免回车首项落在不支持的组合上。
function preferredTypes(path, arch) {
    var data = simulatorData(path);
    var runtimes = iosRuntimesForArchitecture(data, arch).map(function (value) {
        return { value: versionNumber(value.version), entry: value };
    });
    var devices = iphoneTypes(data);
    devices.forEach(function (device, index) {
        device.order = index;
        device.rank = runtimes.reduce(function (rank, runtime) {
            return Math.max(rank, compatibility(device, runtime));
        }, 0);
    });
    devices.sort(function (left, right) {
        return right.rank - left.rank || left.order - right.order;
    });
    return devices.map(function (device) {
        var name = field(device.name || device.identifier);
        // 无可搭配系统的型号仍然列出，标注只用于展示，不进创建参数。
        return device.identifier + '\t'
            + (device.rank === 0 ? name + '（本机无可搭配系统）' : name);
    }).join('\n');
}
// 选定型号后只列可搭配系统；确认支持的排前面，组内版本新的优先。
function compatibleRuntimes(path, arch, deviceIdentifier) {
    var data = simulatorData(path);
    var devices = iphoneTypes(data).filter(function (value) {
        return value.identifier === deviceIdentifier;
    });
    if (devices.length !== 1) {
        throw new Error('所选型号不属于当前设备清单。');
    }
    var runtimes = iosRuntimesForArchitecture(data, arch).map(function (value) {
        return { value: versionNumber(value.version), name: field(value.name || value.identifier),
            identifier: value.identifier, entry: value };
    });
    runtimes.forEach(function (runtime) {
        runtime.rank = compatibility(devices[0], runtime);
    });
    runtimes = runtimes.filter(function (runtime) {
        return runtime.rank > 0;
    });
    runtimes.sort(function (left, right) {
        return right.rank - left.rank || right.value - left.value || left.name.localeCompare(right.name);
    });
    return runtimes.map(function (runtime) {
        return runtime.identifier + '\t'
            + (runtime.rank === 2 ? runtime.name : runtime.name + '（未确认支持）');
    }).join('\n');
}
// 与独立初始化脚本同款命名：型号名@时间-进程号，撞名时追加“ (2)”。
function uniqueName(path, base) {
    var value = readJSON(path);
    var devices = value && value.devices;
    if (!devices || Array.isArray(devices) || typeof devices !== 'object') {
        throw new Error('已有设备 JSON 缺少 devices 对象。');
    }
    var name = field(base);
    if (!name) {
        throw new Error('模拟器名称不能为空。');
    }
    var names = Object.create(null);
    Object.keys(devices).forEach(function (runtime) {
        if (!Array.isArray(devices[runtime])) {
            throw new Error('已有设备 JSON 格式无效。');
        }
        devices[runtime].forEach(function (device) {
            if (device) {
                names[field(device.name)] = true;
            }
        });
    });
    var suffix = 2;
    while (names[name]) {
        name = field(base) + ' (' + suffix + ')';
        suffix += 1;
    }
    return name;
}
// 在引号与 flow 容器之外寻找分隔符，注释符还须位于空白之后。
function delimiter(source, character, comments) {
    var quote = null;
    var depth = 0;
    var escaped = false;
    for (var index = 0; index < source.length; index += 1) {
        var current = source[index];
        if (quote) {
            if (quote === '"' && current === '\\' && !escaped) {
                escaped = true;
                continue;
            }
            if (current === quote && !escaped) {
                if (quote === "'" && source[index + 1] === "'") {
                    index += 1;
                    continue;
                }
                quote = null;
            }
            escaped = false;
        } else if (current === '"' || current === "'") {
            quote = current;
        } else if (current === character && depth === 0) {
            if (!comments || index === 0 || /\s/.test(source[index - 1])) {
                return index;
            }
        } else if (current === '{' || current === '[') {
            depth += 1;
        } else if (current === '}' || current === ']') {
            depth -= 1;
        }
    }
    return -1;
}
// 仅解析保守的单行标量，拒绝锚点、标签与块字符串。
function scalar(source) {
    source = source.trim();
    if (!source) {
        return null;
    }
    if (source[0] === '"') {
        try {
            var value = JSON.parse(source);
            return typeof value === 'string' ? value : null;
        } catch (_) {
            return null;
        }
    }
    if (source[0] === "'") {
        if (source.length < 2 || source[source.length - 1] !== "'") {
            return null;
        }
        var body = source.slice(1, -1);
        return body.replace(/''/g, '').indexOf("'") < 0 ? body.replace(/''/g, "'") : null;
    }
    return /[{}\[\],:#&*!|>"']/.test(source) ? null : source;
}
// 从映射行分离键值，忽略引号或 flow 数据内部的冒号与注释。
function mappingPair(source) {
    var hash = delimiter(source, '#', true);
    var clean = hash >= 0 ? source.slice(0, hash).trim() : source;
    var colon = delimiter(clean, ':', false);
    if (colon < 0) {
        return null;
    }
    var key = scalar(clean.slice(0, colon));
    return key ? { key: key, value: clean.slice(colon + 1).trim() } : null;
}
// 解析单行 flow 映射，遇到重复键或空值立即拒绝。
function flowMapping(source) {
    source = source.trim();
    if (source[0] !== '{' || source[source.length - 1] !== '}') {
        return null;
    }
    var remaining = source.slice(1, -1).trim();
    var result = Object.create(null);
    while (remaining) {
        var comma = delimiter(remaining, ',', false);
        var part = comma >= 0 ? remaining.slice(0, comma) : remaining;
        var pair = mappingPair(part);
        if (!pair || Object.prototype.hasOwnProperty.call(result, pair.key) || !pair.value) {
            return null;
        }
        result[pair.key] = pair.value;
        if (comma < 0) {
            break;
        }
        remaining = remaining.slice(comma + 1).trim();
    }
    return result;
}
// 保持与 Finder 的 Swift validator 相同的块映射 / 单行 flow 识别边界。
function declaresFlutterSDK(text) {
    if (text.indexOf('\u0000') >= 0) {
        return false;
    }
    var entries = [];
    var lines = text.replace(/\r\n/g, '\n').split('\n');
    for (var index = 0; index < lines.length; index += 1) {
        var line = lines[index].replace(/^\uFEFF/, '');
        var trimmed = line.trim();
        if (!trimmed || trimmed[0] === '#') {
            continue;
        }
        if (trimmed === '---' || trimmed === '...' || /^\s*/.exec(line)[0].indexOf('\t') >= 0) {
            return false;
        }
        var indent = /^ */.exec(line)[0].length;
        var pair = mappingPair(line.slice(indent));
        entries.push({ indent: indent, key: pair ? pair.key : '', value: pair ? pair.value : '' });
    }
    var roots = entries.filter(function (entry) { return entry.indent === 0 && entry.key === 'dependencies'; });
    if (roots.length !== 1) {
        return false;
    }
    var root = roots[0];
    var map;
    if (root.value) {
        var dependencies = flowMapping(root.value);
        map = dependencies && dependencies.flutter ? flowMapping(dependencies.flutter) : null;
        return !!map && scalar(map.sdk || '') === 'flutter';
    }
    var rootIndex = entries.indexOf(root);
    var end = rootIndex + 1;
    while (end < entries.length && entries[end].indent > 0) {
        end += 1;
    }
    var children = entries.slice(rootIndex + 1, end);
    if (!children.length) {
        return false;
    }
    var dependencyIndent = Math.min.apply(null, children.map(function (entry) { return entry.indent; }));
    var flutterEntries = children.filter(function (entry) {
        return entry.indent === dependencyIndent && entry.key === 'flutter';
    });
    if (dependencyIndent <= 0 || flutterEntries.length !== 1) {
        return false;
    }
    var flutter = flutterEntries[0];
    if (flutter.value) {
        map = flowMapping(flutter.value);
        return !!map && scalar(map.sdk || '') === 'flutter';
    }
    var flutterIndex = children.indexOf(flutter);
    var flutterEnd = flutterIndex + 1;
    while (flutterEnd < children.length && children[flutterEnd].indent > dependencyIndent) {
        flutterEnd += 1;
    }
    var fields = children.slice(flutterIndex + 1, flutterEnd);
    if (!fields.length) {
        return false;
    }
    var sdkIndent = Math.min.apply(null, fields.map(function (entry) { return entry.indent; }));
    var sdkFields = fields.filter(function (entry) { return entry.indent === sdkIndent && entry.key === 'sdk'; });
    return sdkIndent > dependencyIndent && sdkFields.length === 1 && scalar(sdkFields[0].value) === 'flutter';
}
// 只校验用户选中的真实目录及直属 pubspec，不递归、不读取链接目标。
function validate(project) {
    try {
        project = project.replace(/\/+$/, '') || '/';
        var info = attributes(project);
        if (!info || info.NSFileType !== 'NSFileTypeDirectory') {
            return false;
        }
        var values = ObjC.deepUnwrap($.NSURL.fileURLWithPath($(project)).resourceValuesForKeysError(
            $([$.NSURLIsPackageKey, $.NSURLIsAliasFileKey]), null));
        if (!values || values.NSURLIsPackageKey || values.NSURLIsAliasFileKey) {
            return false;
        }
        return declaresFlutterSDK(readText(project + '/pubspec.yaml', 1024 * 1024));
    } catch (_) {
        return false;
    }
}
// 仅继承 Flutter 与平台工具需要的已授权进程环境，不转储其它变量。
function launchEnvironment() {
    var sourceEnvironment = ObjC.deepUnwrap($.NSProcessInfo.processInfo.environment);
    var environment = {};
    var keys = ['PATH', 'HOME', 'TMPDIR', 'DEVELOPER_DIR', 'ANDROID_HOME', 'ANDROID_SDK_ROOT',
        'ANDROID_AVD_HOME', 'ANDROID_USER_HOME', 'ANDROID_EMULATOR_HOME', 'JAVA_HOME',
        'PUB_CACHE', 'PUB_HOSTED_URL', 'FLUTTER_STORAGE_BASE_URL', 'HTTPS_PROXY', 'HTTP_PROXY', 'ALL_PROXY', 'NO_PROXY',
        'https_proxy', 'http_proxy', 'all_proxy', 'no_proxy'];
    keys.forEach(function (key) {
        if (Object.prototype.hasOwnProperty.call(sourceEnvironment, key)) {
            environment[key] = sourceEnvironment[key];
        }
    });
    return environment;
}
// 验证当前会话与 label 后原子写入 plist，保护环境字段与路径边界。
function writeLaunchPlist(session, label, plist) {
    if (!/^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$/.test(label)) {
        throw new Error('launchd label 无效。');
    }
    var sessionInfo = attributes(session);
    if (!sessionInfo || sessionInfo.NSFileType !== 'NSFileTypeDirectory') {
        throw new Error('launchd 会话目录无效。');
    }
    var destination = session + '/job.plist';
    var existing = attributes(destination);
    if (existing && existing.NSFileType !== 'NSFileTypeRegular') {
        throw new Error('拒绝覆盖非普通 job.plist。');
    }
    var data = $.NSPropertyListSerialization.dataWithPropertyListFormatOptionsError(
        $(plist), $.NSPropertyListXMLFormat_v1_0, 0, null);
    if (!data || !data.writeToFileAtomically($(destination), true)) {
        throw new Error('无法写入 launchd plist。');
    }
    if (!$.NSFileManager.defaultManager.setAttributesOfItemAtPathError(
        $({ NSFilePosixPermissions: 384 }), $(destination), null)) {
        throw new Error('无法限制 launchd plist 权限。');
    }
    return destination;
}
// 所有 launchd 路径都作为独立参数，禁止相对路径和 NUL 字节。
function validateLaunchPaths(paths) {
    paths.forEach(function (path) {
        if (typeof path !== 'string' || path[0] !== '/' || path.indexOf('\u0000') >= 0) {
            throw new Error('launchd 路径必须是绝对路径。');
        }
    });
}
// 生成独立 Flutter worker 配置，终端退出不会向其传递 EOF 或 HUP。
function writePlist(args) {
    var session = args[0];
    var label = args[1];
    var worker = args[2];
    var project = args[3];
    var flutter = args[4];
    var device = args[5];
    validateLaunchPaths([session, worker, project, flutter]);
    var workerInfo = attributes(worker);
    if (!workerInfo || workerInfo.NSFileType !== 'NSFileTypeRegular' || !validate(project) || !identifier(device)) {
        throw new Error('launchd 运行器、Flutter 项目或设备无效。');
    }
    return writeLaunchPlist(session, label, {
        Label: label,
        ProgramArguments: ['/bin/zsh', worker, '--worker', session, project, flutter, device],
        WorkingDirectory: project,
        RunAtLoad: true,
        KeepAlive: false,
        StandardOutPath: session + '/run.log',
        StandardErrorPath: session + '/run.log',
        EnvironmentVariables: launchEnvironment(),
        ExitTimeOut: 20,
        ProcessType: 'Interactive'
    });
}
// 直接托管 SDK emulator 主进程，AVD 生命周期独立于 Flutter 调试会话。
function writeEmulatorPlist(args) {
    var session = args[0];
    var label = args[1];
    var emulator = args[2];
    var avdID = args[3];
    validateLaunchPaths([session, emulator]);
    var emulatorInfo = attributes(emulator);
    if (!emulatorInfo || emulatorInfo.NSFileType !== 'NSFileTypeRegular' || !identifier(avdID)
        || !$.NSFileManager.defaultManager.isExecutableFileAtPath($(emulator))) {
        throw new Error('Android emulator 可执行文件或 AVD 标识无效。');
    }
    var directory = ObjC.unwrap($(emulator).stringByDeletingLastPathComponent);
    return writeLaunchPlist(session, label, {
        Label: label,
        ProgramArguments: [emulator, '-avd', avdID],
        WorkingDirectory: directory,
        RunAtLoad: true,
        KeepAlive: false,
        StandardOutPath: session + '/emulator.log',
        StandardErrorPath: session + '/emulator.log',
        EnvironmentVariables: launchEnvironment(),
        ExitTimeOut: 20,
        ProcessType: 'Interactive'
    });
}
// 读取项目 FVM 声明版本；只接受可安全作为命令行参数的版本或频道名。
function fvmVersion(path) {
    var value = readJSON(path);
    var version = value && (value.flutter || value.flutterSdkVersion);
    if (typeof version !== 'string') {
        throw new Error('FVM 配置没有声明版本。');
    }
    if (!/^[0-9A-Za-z][0-9A-Za-z._+\-/:@]{0,63}$/.test(version)) {
        throw new Error('FVM 声明的版本不可用作命令参数。');
    }
    return version;
}
// 从 Flutter machine 日志取得最近一次 app.start，生成 daemon 控制消息。
function daemonCommand(path, operation) {
    if (['reload', 'restart', 'stop'].indexOf(operation) < 0) {
        throw new Error('未知 Flutter 控制操作。');
    }
    var appID = null;
    readText(path, 512 * 1024 * 1024).split(/\r?\n/).forEach(function (line) {
        try {
            var values = JSON.parse(line);
            (Array.isArray(values) ? values : [values]).forEach(function (value) {
                if (value && value.event === 'app.start' && value.params && typeof value.params.appId === 'string'
                    && value.params.appId.length && !/[\u0000-\u001f\u007f-\u009f]/.test(value.params.appId)) {
                    appID = value.params.appId;
                }
            });
        } catch (_) {
            // 原始日志始终保留；终端另行格式化，不影响控制协议读取。
        }
    });
    if (!appID) {
        throw new Error('Flutter 尚未返回 app.start，暂时无法控制应用。');
    }
    var params = { appId: appID };
    if (operation !== 'stop') {
        params.fullRestart = operation === 'restart';
        params.pause = false;
    }
    return JSON.stringify([{ id: Date.now(), method: operation === 'stop' ? 'app.stop' : 'app.restart', params: params }]);
}
// 将 machine 协议转为人读日志；只折叠已知噪声，未知消息与错误保留。
function logFormatter(write) {
    var progress = Object.create(null), packages = 0, warnings = 0, spm = false, systemIndexNotice = false;
    function emit(level, text) {
        String(text).split(/\r?\n/).forEach(function (line) {
            if (line.trim()) write('[' + level + '] ' + line.replace(/\x1b\[[0-?]*[ -/]*[@-~]/g, '').replace(/[\u0000-\u0008\u000b-\u001f\u007f]/g, ''));
        });
    }
    function warning(text) { warnings++; emit('警告', text); }
    // 只识别系统索引器的固定诊断；Flutter 协议事件先解析，不按关键词隐藏应用错误。
    function systemIndexDiagnostic(line) {
        var parameter = /^Failed to index (?:parameter type|action parameter): <WF[A-Za-z0-9_]+:/.test(line)
            && /\(extension in ActionKit\):__C\.WFParameter\.ToolKitConversionError\./.test(line);
        var spotlight = /^Failed to check availability in Spotlight for action (?:is\.workflow\.actions\.|com\.apple\.)/.test(line)
            && /NSOSStatusErrorDomain Code=-10814\b/.test(line);
        if (!parameter && !spotlight) return false;
        if (!systemIndexNotice) {
            emit('提示', 'macOS 快捷指令 / Spotlight 系统索引诊断已折叠；Flutter 构建状态请以应用启动事件及退出码判断，详情见原始日志。');
            systemIndexNotice = true;
        }
        return true;
    }
    function stage(message) {
        if (/Running pod install/.test(message)) return '安装 iOS CocoaPods 依赖';
        if (/Running Xcode build/.test(message)) return 'Xcode 编译';
        if (/Syncing files to device/.test(message)) return '同步文件到设备';
        if (/hot reload/i.test(message)) return '热重载';
        if (/hot restart/i.test(message)) return '热重启';
        return message;
    }
    function event(value) {
        var p = value.params || {}, name = value.event;
        if (value.error) { emit('错误', typeof value.error === 'string' ? value.error : JSON.stringify(value.error)); return; }
        if (!name) {
            var result = value.result;
            if (result && typeof result === 'object' && result.code !== undefined) {
                emit(result.code === 0 ? '完成' : '错误', result.message || ('操作返回码：' + result.code));
            } else emit('协议', JSON.stringify(value));
            return;
        }
        switch (name) {
            case 'daemon.connected': case 'device.added': case 'device.removed': case 'app.dtd': return;
            case 'app.start': emit('启动', '目标设备：' + (p.deviceId || '未知') + '；模式：' + (p.mode || 'debug')); return;
            case 'app.started':
                emit('成功', '应用已启动，调试连接已建立。' + (warnings ? ' 本次有 ' + warnings + ' 条警告，请按上方说明处理。' : ''));
                emit('控制', 'r 热重载 / R 热重启 / s 停止 / d 离开（输入后回车）'); return;
            case 'app.progress':
                var key = String(p.appId || '') + ':' + String(p.id);
                if (!p.finished) { progress[key] = stage(p.message || '处理中'); emit('进行', progress[key]); }
                // finished 只表示阶段结束（失败时也会发出），不能当作成功。
                else { emit('进度', (progress[key] || stage(p.message || '当前阶段')) + '结束'); delete progress[key]; }
                return;
            case 'app.debugPort': emit('调试', 'Dart VM：' + (p.wsUri || ('端口 ' + p.port))); return;
            case 'app.devTools': emit('调试', 'DevTools：' + (p.uri || '')); return;
            case 'app.stop': emit('结束', '应用已停止。'); return;
            case 'app.log': emit(p.error ? '错误' : '应用', p.log || p.message || ''); return;
            case 'daemon.log': case 'daemon.logMessage':
                if (p.error || p.level === 'error') emit('错误', p.message || p.log || JSON.stringify(p));
                else if (p.level === 'warning') warning(p.message || p.log || JSON.stringify(p));
                else emit('日志', p.message || p.log || JSON.stringify(p));
                return;
            default: emit('事件', name + ' ' + JSON.stringify(p));
        }
    }
    return function (raw) {
        var line = raw.replace(/\x1b\[[0-?]*[ -/]*[@-~]/g, '').replace(/\r$/, '');
        if (!line.trim()) return;
        var values;
        try { values = JSON.parse(line); } catch (_) {}
        if (Array.isArray(values) && values.length && values.every(function (v) {
            return v && typeof v === 'object' && (v.event || v.id !== undefined || v.error);
        })) { values.forEach(event); return; }
        if (line === 'Resolving dependencies...') { emit('依赖', '解析依赖…'); return; }
        if (line === 'Downloading packages...') { emit('依赖', '下载并检查依赖…'); return; }
        if (/^[ >+*!-] [a-zA-Z0-9_]+ [0-9][^ ]*(?: .*)?$/.test(line)) {
            packages++;
            if (/discontinued|retracted|advisory/i.test(line)) warning(line.trim());
            return;
        }
        if (line === 'Got dependencies!') { emit('完成', '依赖就绪。' + (packages ? ' 已折叠 ' + packages + ' 条版本明细，完整信息见原始日志。' : '')); return; }
        if (/^\d+ packages? (?:have|has) newer versions/.test(line)) {
            warning(line.match(/^\d+/)[0] + ' 个依赖有新版，但受当前约束限制；不表示本次运行失败。'); return;
        }
        if (/^\d+ packages? (?:is|are) discontinued\./.test(line)) { warning('存在停止维护的依赖：' + line + ' 详情见原始日志。'); return; }
        if (/^Try `flutter pub outdated`/.test(line)) { emit('提示', '可运行 flutter pub outdated 查看依赖更新详情。'); return; }
        if (/^The following plugins do not support Swift Package Manager/.test(line)) {
            spm = true; warning('以下插件尚不支持 Swift Package Manager，当前使用 CocoaPods 兼容处理：'); return;
        }
        if (spm && /^\s+- /.test(line)) { emit('警告', '  ' + line.trim()); return; }
        if (spm && /^This will become an error/.test(line)) {
            spm = false; emit('警告', '未来 Flutter 版本可能不再兼容，请关注上述插件的更新。当前是否成功以启动结果为准。'); return;
        }
        if (/^Xcode build done\./.test(line)) {
            // Flutter 在检查 xcodebuild 退出码之前就打印 done，不能据此宣告成功。
            emit('进度', line);
            emit('进行', '正在确认构建结果并准备设备连接，首次安装可能较慢…');
            return;
        }
        if (/^Launching /.test(line)) { emit('启动', line); return; }
        if (/^Flutter 后台运行：/.test(line)) { emit('会话', line); return; }
        if (/^Flutter 已退出：/.test(line)) return; // 使用退出标记统一显示最终状态。
        if (/Using the Impeller rendering backend/.test(line)) { emit('渲染', 'Impeller / Metal 已启用。'); return; }
        // 系统动作索引的类型 / 缺失扩展诊断与 Flutter 编译无关，原始日志仍完整保留。
        if (systemIndexDiagnostic(line)) return;
        if (/^Cleared Cascade pull bookmarks after full reindex$/.test(line)
            || /^Skipping: <WF[A-Za-z0-9_]+:.*because union values themselves are not treated as a type$/.test(line)
            || /^is\.workflow\.actions\.[A-Za-z0-9_.]+ WF[A-Za-z0-9_]+: Skipped because: \[(?:control flow|donation-based action)\]$/.test(line)
            || /^Skipped: \[(?:donation-based action|control flow):/.test(line)
            || /^\s+(?:donation-based action|control flow): \d+$/.test(line)) return;
        // 正常索引计数留在原始日志；非零 Errored 与未知错误继续展示。
        if (/^(-\[WFIsolatedShortcutRunner (init|init\]_block_invoke|unaliveProcess)|Indexing for request:|Type indexing \(params|Action indexing took|Indexed: \d+$|Errored: 0$|Skipped: \[:\]$|Bundle cache: \d+ hits|Finished in [\d.]+s$)/.test(line)) return;
        if (/error|exception|failed|fatal|^Errored: [1-9]/i.test(line)) emit('错误', line);
        else if (/warning|deprecated|discontinued/i.test(line)) warning(line);
        else emit('日志', line);
    };
}

// 按块跟踪原始日志，保留跨写入的 UTF-8 字符及半行；不启动 tail 子进程。
function watchLog(path, exitPath) {
    var info = attributes(path);
    if (!info || info.NSFileType !== 'NSFileTypeRegular') throw new Error('运行日志不是普通文件。');
    var handle = $.NSFileHandle.fileHandleForReadingAtPath($(path));
    var stdout = $.NSFileHandle.fileHandleWithStandardOutput;
    function write(line) { stdout.writeData($(line + '\n').dataUsingEncoding($.NSUTF8StringEncoding)); }
    var format = logFormatter(write), pending = $.NSMutableData.data, text = '';
    function decode(final) {
        var count = Number(pending.length), decoded, used;
        for (var cut = 0; cut <= Math.min(3, count); cut++) {
            used = count - cut;
            decoded = ObjC.unwrap($.NSString.alloc.initWithDataEncoding(pending.subdataWithRange($.NSMakeRange(0, used)), $.NSUTF8StringEncoding));
            if (typeof decoded === 'string') break;
        }
        if (typeof decoded !== 'string' || (final && used !== count)) {
            used = count;
            decoded = ObjC.unwrap($.NSString.alloc.initWithDataEncoding(pending, $.NSISOLatin1StringEncoding));
        }
        text += decoded || '';
        var rest = pending.subdataWithRange($.NSMakeRange(used, count - used));
        pending = $.NSMutableData.dataWithData(rest);
        var lines = text.split('\n'); text = lines.pop(); lines.forEach(format);
    }
    try {
        while (true) {
            var data = handle.readDataOfLength(65536);
            if (Number(data.length)) { pending.appendData(data); decode(false); continue; }
            if (attributes(exitPath)) {
                // 再读取一次，避免 EOF 检查与 worker 最终写入之间的竞争。
                data = handle.readDataOfLength(65536);
                if (Number(data.length)) { pending.appendData(data); decode(false); continue; }
                decode(true); if (text) format(text);
                var code = readText(exitPath, 64).trim();
                write((code === '0' ? '[结束] Flutter 正常退出。' : '[错误] Flutter 退出，退出码：' + code + '。请检查上方错误与完整原始日志。'));
                break;
            }
            $.NSThread.sleepForTimeInterval(0.2);
        }
    } finally { handle.closeFile; }
}

// 严格分发内部协议，参数数量错误时直接失败。
function run(argv) {
    var mode = argv[0];
    var args = argv.slice(1);
    if (mode === 'watch-log' && args.length === 2) {
        watchLog(args[0], args[1]); return;
    }
    if (mode === 'format-log' && args.length === 1) {
        var output = [], format = logFormatter(function (line) { output.push(line); });
        readText(args[0], 16 * 1024 * 1024).split('\n').forEach(format);
        return output.join('\n');
    }
    if (mode === 'validate' && args.length === 1) {
        return validate(args[0]) ? 'true' : 'false';
    }
    if (mode === 'devices' && (args.length === 1 || args.length === 2)) {
        return devices(args[0], args[1]);
    }
    if (mode === 'emulators' && args.length === 1) {
        return emulators(args[0]);
    }
    if (mode === 'simulators' && args.length === 1) {
        return simulators(args[0]);
    }
    if (mode === 'runtimes' && args.length === 1) {
        return runtimes(args[0]);
    }
    if (mode === 'types' && args.length === 1) {
        return deviceTypes(args[0]);
    }
    if (mode === 'preferred-types' && (args.length === 1 || args.length === 2)) {
        return preferredTypes(args[0], args[1] || '');
    }
    if (mode === 'compatible-runtimes' && args.length === 3) {
        return compatibleRuntimes(args[0], args[1], args[2]);
    }
    if (mode === 'fvm-version' && args.length === 1) {
        return fvmVersion(args[0]);
    }
    if (mode === 'unique-name' && args.length === 2) {
        return uniqueName(args[0], args[1]);
    }
    if (mode === 'plist' && args.length === 6) {
        return writePlist(args);
    }
    if (mode === 'emulator-plist' && args.length === 4) {
        return writeEmulatorPlist(args);
    }
    if (mode === 'command' && args.length === 2) {
        return daemonCommand(args[0], args[1]);
    }
    throw new Error('FlutterRunner 数据助手参数无效。');
}
