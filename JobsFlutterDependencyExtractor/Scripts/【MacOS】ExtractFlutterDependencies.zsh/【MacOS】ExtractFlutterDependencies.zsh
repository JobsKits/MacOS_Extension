# read 的命令替换会使 stdout 成为管道，按输入与提示所在 stderr 判断终端。
jobs_prompt_render() {
  local jobs_prompt_color=0
  if [ -t 0 ] && [ -t 2 ] && jobs_prompt_color_ready; then jobs_prompt_color=1; fi
  printf "%s" "$1" | jobs_prompt_format "$jobs_prompt_color" 0 0 1
}
# 仅放在显示链末端；tee 在此函数之前接收纯文本，不把 ANSI 写入日志。
jobs_prompt_stream() {
  local jobs_prompt_color=0
  if [ -t 1 ] && jobs_prompt_color_ready; then jobs_prompt_color=1; fi
  jobs_prompt_format "$jobs_prompt_color" 1 1
}
# 显示管道保留原末尾换行；只删除本轮追加的最后一个结束标记。
jobs_prompt_filter() {
  local jobs_prompt_color=0
  if [ -t 1 ] && jobs_prompt_color_ready; then jobs_prompt_color=1; fi
  { /bin/cat; printf '\001'; } | jobs_prompt_format "$jobs_prompt_color" 2 1
}
# 仅包装原 printf/echo/print 展示，原参数、尾换行与显示命令退出码保持不变。
jobs_prompt_output() {
  local jobs_prompt_status=0 jobs_prompt_stderr=0 jobs_prompt_arg="" jobs_prompt_previous=""
  if [ "${1:-}" = print ]; then
    for jobs_prompt_arg in "$@"; do
      case "$jobs_prompt_arg" in -?*u2*|-u2) jobs_prompt_stderr=1 ;; esac
      if [ "$jobs_prompt_previous" = -u ] && [ "$jobs_prompt_arg" = 2 ]; then jobs_prompt_stderr=1; fi
      jobs_prompt_previous="$jobs_prompt_arg"
      [ "$jobs_prompt_arg" != -- ] || break
    done
  fi
  if [ -n "${ZSH_VERSION:-}" ]; then
    if [ "$jobs_prompt_stderr" = 1 ]; then
      "$@" 2>&1 | jobs_prompt_filter >&2
      jobs_prompt_status=$(( ${pipestatus[1]} != 0 ? ${pipestatus[1]} : ${pipestatus[2]} ))
    else
      "$@" | jobs_prompt_filter
      jobs_prompt_status=$(( ${pipestatus[1]} != 0 ? ${pipestatus[1]} : ${pipestatus[2]} ))
    fi
  elif [ -n "${BASH_VERSION:-}" ]; then
    "$@" | jobs_prompt_filter
    jobs_prompt_status=$(( ${PIPESTATUS[0]} != 0 ? ${PIPESTATUS[0]} : ${PIPESTATUS[1]} ))
  else
    "$@" | jobs_prompt_filter
    jobs_prompt_status=$?
  fi
  return "$jobs_prompt_status"
}
# 仅替换日志 primitive 的 tee：磁盘同步追加纯文，终端保留非选项原色。
jobs_prompt_tee() {
  local jobs_prompt_log="$1" jobs_prompt_line="" jobs_prompt_newline=0
  while :; do
    jobs_prompt_line=""
    if IFS= read -r jobs_prompt_line; then jobs_prompt_newline=1; else jobs_prompt_newline=0; [ -n "$jobs_prompt_line" ] || break; fi
    if [ "$jobs_prompt_newline" = 1 ]; then
      { printf '%s\n' "$jobs_prompt_line"; printf '\001'; } | jobs_prompt_format 0 2 >> "$jobs_prompt_log" || return $?
      printf '%s\n' "$jobs_prompt_line" | jobs_prompt_filter || return $?
    else
      { printf '%s' "$jobs_prompt_line"; printf '\001'; } | jobs_prompt_format 0 2 >> "$jobs_prompt_log" || return $?
      printf '%s' "$jobs_prompt_line" | jobs_prompt_filter || return $?
    fi
  done
}
# JOBS_INPUT_CHOICE_STYLE_END

PRIVATE_ONLY=0
typeset -a SCOPE_ARGS=()
SCRIPT_DIR=""
SCRIPT_PATH=""
LOG_FILE=""
PROJECT_PATH=""
DESTINATION_PATH=""
DART_EXECUTABLE=""
EXTRACTION_OUTPUT=""
# 自述根据终端能力降级为纯文本，不给日志加入 ANSI。
intro_line() {
  local role="$1" message="$2" code="0;34"
  [[ "$role" == title ]] && code="1;31"
  if [[ -t 1 && -n "${TERM:-}" && "$TERM" != dumb && -z "${NO_COLOR+x}" ]]; then
    printf '\033[%sm%s\033[0m\n' "$code" "$message"
  else
    print -r -- "$message"
  fi
}
# 业务开始前打印内置自述并等待回车，EOF 与非空输入取消。
show_script_intro_and_wait() {
  intro_line title '提取 Flutter 第三方依赖'
  intro_line body '1、复制实际解析的 Pub 直接、间接、开发依赖及插件包内平台源码。'
  intro_line body '2、只读源项目与缓存；输出独立目录、依赖清单和许可证，不自动 pub get。'
  jobs_prompt_output intro_line body '3、目标可输入或拖入，直接回车使用系统桌面；Ctrl+C 随时取消。'
  intro_line body '4、日志在确认后创建于系统临时目录；缺失或损坏的 Dart 需自行修复。'
  local answer=""
  IFS= read -r "answer?$(jobs_prompt_render '已了解用途与范围，按回车继续；非空取消：')" || exit 0
  [[ -z "$answer" ]] || exit 0
}
# 初始化日志、定位同目录引擎；环境变更仅作用于本进程。
initialize_runtime() {
  setopt NO_NOMATCH PIPE_FAIL
  umask 077
  SCRIPT_DIR="$(jobs_layout_directory "${BASH_SOURCE[0]:-${(%):-%x}}")"
  SCRIPT_PATH="${${BASH_SOURCE[0]:-${(%):-%x}}:A}"
  LOG_FILE="$(/usr/bin/mktemp "${TMPDIR:-/tmp/}JobsFlutterDependencyExtractor.XXXXXX")" || exit 1
  [[ -f "$SCRIPT_DIR/ExtractFlutterDependencies.dart" ]] || die '缺少同目录 ExtractFlutterDependencies.dart，请保留完整脚本包。'
  log "日志：$LOG_FILE"
}
# 同步打印并保存纯文本业务记录。
log() {
  print -r -- "$1" | jobs_prompt_tee "$LOG_FILE"
}
# 输出可定位的错误并终止。
die() {
  log "✖ $1"
  exit 1
}
# 将普通路径和 Terminal 拖入的 Shell 单词还原为数据，绝不 eval。
normalize_path_input() {
  local raw="$1" candidate="" word=""
  local -a words=()
  raw="${raw%$'\r'}"
  if [[ -e "$raw" ]]; then
    REPLY="$raw"
    return 0
  fi
  if [[ "$raw" != *\\* && "$raw" != \"* && "$raw" != \'* ]]; then
    candidate="$raw"
    [[ "$candidate" == '~' ]] && candidate="$HOME"
    [[ "$candidate" == '~/'* ]] && candidate="$HOME/${candidate#\~/}"
    [[ -n "$candidate" ]] || die '请输入或拖入一个目录。'
    REPLY="$candidate"
    return 0
  fi
  # zsh 的 z/Q 只做词法解析及去引号，不执行变量、替换或重定向。
  words=("${(@z)raw}")
  for word in "${words[@]}"; do
    candidate="${(Q)word}"
    [[ -n "$candidate" ]] || continue
    [[ "${#words}" == 1 ]] || die '一次只接受一个目录，请重新运行。'
  done
  [[ "${#words}" == 1 ]] || die '请输入或拖入一个目录。'
  [[ "$candidate" == '~' ]] && candidate="$HOME"
  [[ "$candidate" == '~/'* ]] && candidate="$HOME/${candidate#\~/}"
  [[ "$candidate" != *$'\n'* && "$candidate" != *$'\r'* ]] || die '交互路径不能含换行；请使用命令参数。'
  REPLY="$candidate"
}
# Finder 已带入项目时直接使用参数，桌面入口则要求输入或拖入。
read_project_and_destination() {
  local input="" desktop=""
  (( $# <= 1 )) || die '用法：脚本 [Flutter项目目录]'
  if (( $# == 1 )); then
    PROJECT_PATH="$1"
  else
    IFS= read -r "input?$(jobs_prompt_render '输入或拖入 Flutter 项目文件夹：')" || exit 0
    normalize_path_input "$input"
    PROJECT_PATH="$REPLY"
  fi
  [[ -d "$PROJECT_PATH" && ! -L "$PROJECT_PATH" ]] || die '项目必须是存在的普通文件夹。'
  PROJECT_PATH="${PROJECT_PATH:A}"
  [[ -f "$PROJECT_PATH/pubspec.yaml" && ! -L "$PROJECT_PATH/pubspec.yaml" ]] || die '所选目录同层缺少普通 pubspec.yaml。'
  desktop="$(/usr/bin/osascript -e 'POSIX path of (path to desktop folder)' 2>/dev/null)" || desktop=""
  [[ -n "$desktop" ]] || desktop="$HOME/Desktop"
  IFS= read -r "input?$(jobs_prompt_render "输入或拖入输出父目录（直接回车：${desktop}）：")" || exit 0
  if [[ -z "$input" ]]; then
    DESTINATION_PATH="$desktop"
  else
    normalize_path_input "$input"
    DESTINATION_PATH="$REPLY"
  fi
}
# 只复用 Flutter 自带的原生 Dart，不执行会隐式下载的 FVM / Flutter shim。
check_environment() {
  local candidate="" discovered="" flutter_path=""
  local -a candidates=()
  candidates+=("$PROJECT_PATH/.fvm/flutter_sdk/bin/cache/dart-sdk/bin/dart")
  discovered="$(command -v dart 2>/dev/null)"
  if [[ -n "$discovered" && -e "$discovered" ]]; then
    discovered="${discovered:A}"
    candidates+=("$discovered")
    [[ "$discovered" == */bin/dart ]] && candidates+=("${discovered:h}/cache/dart-sdk/bin/dart")
  fi
  flutter_path="$(command -v flutter 2>/dev/null)"
  if [[ -n "$flutter_path" && -e "$flutter_path" ]]; then
    flutter_path="${flutter_path:A}"
    candidates+=("${flutter_path:h}/cache/dart-sdk/bin/dart")
  fi
  candidates+=("$HOME/fvm/default/bin/cache/dart-sdk/bin/dart" "/opt/homebrew/share/flutter/bin/cache/dart-sdk/bin/dart" "/usr/local/share/flutter/bin/cache/dart-sdk/bin/dart")
  for candidate in "${candidates[@]}"; do
    # Flutter 的 bin/dart 是 Shell 引导脚本，优先且仅运行 SDK 原生二进制。
    [[ -x "$candidate" && "$candidate" == */dart-sdk/bin/dart ]] || continue
    /usr/bin/file -b "${candidate:A}" | /usr/bin/grep -q 'Mach-O' || continue
    if "$candidate" --version </dev/null >/dev/null 2>&1; then
      DART_EXECUTABLE="$candidate"
      log "✔ Dart：$DART_EXECUTABLE"
      return 0
    fi
  done
  # 独立安装的 Dart SDK 也可以复用，但须是原生 Mach-O 而非 shim。
  if [[ -n "$discovered" && -x "$discovered" ]] && /usr/bin/file -b "$discovered" | /usr/bin/grep -q 'Mach-O'; then
    if "$discovered" --version </dev/null >/dev/null 2>&1; then
      DART_EXECUTABLE="$discovered"
      log "✔ Dart：$DART_EXECUTABLE"
      return 0
    fi
  fi
  die '没有健康的本地 Dart SDK。请先安装 / 修复 Flutter 或 Dart，再重新运行；本工具不会自动下载。'
}
# 私库是默认范围，非空（含空格）才明确全提取；专用私库入口不重复选择。
choose_extraction_scope() {
  local answer=""
  if (( PRIVATE_ONLY )); then
    log '🔐 私库模式：仅提取 Git、path 和自建 Pub 源候选。'
    return 0
  fi
  log '🔐 默认只提取私库候选：Git、path、自建 Pub 源；这不等于已验证仓库访问权限。'
  IFS= read -r "answer?$(jobs_prompt_render '直接回车 = 只提取私库；输入任意字符再回车 = 全提取：')" || exit 0
  if [[ -z "$answer" ]]; then
    PRIVATE_ONLY=1
    SCOPE_ARGS=(--private-only)
  else
    SCOPE_ARGS=()
    log '➤ 已明确选择全提取：包含公共 Pub 包。'
  fi
}
# 参数逐项传给 Dart；管道保留引擎失败码，不把部分复制误报为成功。
run_extraction() {
  local extraction_result=0
  log "来源项目：$PROJECT_PATH"
  log "输出父目录：$DESTINATION_PATH"
  "$DART_EXECUTABLE" "$SCRIPT_DIR/ExtractFlutterDependencies.dart" \
    --project "$PROJECT_PATH" \
    --destination "$DESTINATION_PATH" "${SCOPE_ARGS[@]}" 2>&1 | /usr/bin/tee -a "$LOG_FILE"
  extraction_result=$?
  if (( extraction_result != 0 )); then
    log "✖ 未完成，退出码 $extraction_result；日志：$LOG_FILE"
    exit "$extraction_result"
  fi
  local line=""
  while IFS= read -r line; do
    [[ "$line" != '✔ 提取完成：'* ]] || EXTRACTION_OUTPUT="${line#✔ 提取完成：}"
  done < "$LOG_FILE"
  [[ -n "$EXTRACTION_OUTPUT" && -d "$EXTRACTION_OUTPUT" && ! -L "$EXTRACTION_OUTPUT" && "${EXTRACTION_OUTPUT:A:h}" == "${DESTINATION_PATH:A}" ]] || die '未取得本次完整导出目录，未压缩或删除任何目录。'
  offer_extraction_zip || return $?
  log "✔ 完成。日志：$LOG_FILE"
}
# 对照已解压的 ZIP 核对整个目录；新增链接、隐藏文件或内容变化均阻止删除。
extraction_zip_source_matches() {
    local source="$1" verified="$2" unusual=""
    [[ -d "$source" && ! -L "$source" && -d "$verified" && ! -L "$verified" ]] || return 1
    unusual="$(/usr/bin/find "$source" ! -type f ! -type d -print -quit 2>> "$LOG_FILE")" || return 1
    [[ -z "$unusual" ]] || return 1
    /usr/bin/diff -qr "$source" "$verified" >> "$LOG_FILE" 2>&1
}
# ZIP 先写私有临时文件并解压核验完整目录；删除前再次比较，保留确认期间改动。
offer_extraction_zip() {
    local answer="" archive="$EXTRACTION_OUTPUT.zip" temporary="" verification="" verified="" fingerprint="" current=""
    IFS= read -r "answer?$(jobs_prompt_render '是否打包为 ZIP？直接回车 = 打包；任意字符再回车 = 不打包：')" || return 130
    if [[ -n "$answer" ]]; then log "✔ 保留提取目录：$EXTRACTION_OUTPUT"; return 0; fi
    [[ ! -e "$archive" && ! -L "$archive" ]] || { log "✖ ZIP 已存在，未覆盖：$archive；提取目录保留。"; return 1; }
    fingerprint="$(/usr/bin/shasum -a 256 "$EXTRACTION_OUTPUT/manifest.json")" || return 1
    temporary="$(/usr/bin/mktemp "${archive}.partial.XXXXXX")" || return 1
    verification="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp/}JobsFlutterZipVerify.XXXXXX")" || { /bin/rm -f -- "$temporary"; return 1; }
    verified="$verification/${EXTRACTION_OUTPUT:t}"
    if ! /usr/bin/ditto -c -k --keepParent "$EXTRACTION_OUTPUT" "$temporary" >> "$LOG_FILE" 2>&1 ||
       ! /usr/bin/unzip -tq "$temporary" >> "$LOG_FILE" 2>&1 ||
       ! /usr/bin/ditto -x -k "$temporary" "$verification" >> "$LOG_FILE" 2>&1 ||
       ! extraction_zip_source_matches "$EXTRACTION_OUTPUT" "$verified"; then
        /bin/rm -f -- "$temporary"
        /bin/rm -r -- "$verification"
        log '✖ ZIP 生成、解压或完整目录核对失败，提取目录完整保留；详情见日志。'
        return 1
    fi
    current="$(/usr/bin/shasum -a 256 "$EXTRACTION_OUTPUT/manifest.json")" || current=""
    if [[ "$current" != "$fingerprint" ]]; then
        /bin/rm -f -- "$temporary"
        /bin/rm -r -- "$verification"
        log '✖ 打包期间清单发生变化，原目录保留。'
        return 1
    fi
    if ! /bin/mv -n -- "$temporary" "$archive" || [[ -e "$temporary" ]]; then
        /bin/rm -f -- "$temporary"
        /bin/rm -r -- "$verification"
        log '✖ ZIP 目标发生冲突，原目录保留。'
        return 1
    fi
    log "✔ ZIP 已完成并校验：$archive"
    if ! IFS= read -r "answer?$(jobs_prompt_render '是否删除原始提取目录？直接回车 = 不删除；任意字符再回车 = 删除：')"; then
        /bin/rm -r -- "$verification"
        return 130
    fi
    if [[ -z "$answer" ]]; then
        /bin/rm -r -- "$verification"
        log "✔ 保留提取目录：$EXTRACTION_OUTPUT"
        return 0
    fi
    current="$(/usr/bin/shasum -a 256 "$EXTRACTION_OUTPUT/manifest.json")" || current=""
    if [[ -L "$EXTRACTION_OUTPUT" || ! -d "$EXTRACTION_OUTPUT" || "${EXTRACTION_OUTPUT:A:h}" != "${DESTINATION_PATH:A}" || "$current" != "$fingerprint" ]] ||
       ! extraction_zip_source_matches "$EXTRACTION_OUTPUT" "$verified"; then
        /bin/rm -r -- "$verification"
        log '✖ 提取目录或文件内容在打包后发生变化，未删除；原目录与已验证 ZIP 均保留。'
        return 1
    fi
    /bin/rm -r -- "$verification"
    /bin/rm -r -- "$EXTRACTION_OUTPUT" || return 1
    log '✔ 已按选择删除本次提取目录，ZIP 保留。'
}
# 自述确认后才创建日志并访问业务路径。
main() {
  show_script_intro_and_wait # 展示范围并等待回车，避免双击误触。
  initialize_runtime # 初始化私有日志与同目录引擎路径。
  read_project_and_destination "$@" # 读取项目和可拖入目标，空目标默认桌面。
  choose_extraction_scope # 默认私库，只有非空输入才纳入公共依赖。
  check_environment # 体检已有原生 Dart，不隐式下载或修改配置。
  run_extraction # 执行本地快照并保留失败码。
}

main "$@"
